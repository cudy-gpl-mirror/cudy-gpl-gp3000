			};
		};

		pins_led4: pins_led4 {
			mux {
				function = "led4";
				groups = "led4_group";
			};
		};

		pins_led4_q: pins_led4_q {
			mux {
				function = "led4";
				groups = "led4_q_group";
			};
		};

		pins_led5: pins_led5 {
			mux {
				function = "led5";
				groups = "led5_group";
			};
		};

		pins_led5_q: pins_led5_q {
			mux {
				function = "led5";
				groups = "led5_q_group";
			};
		};

		pins_led6: pins_led6 {
			mux {
