#include "../../../../../include/generated/autoconf.h"
#include <dt-bindings/soc/rtk_9607f_irqs.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/reset/rtk9607f,rst-mgr.h>
#include <dt-bindings/phy/phy-rtl8277c.h>
#include <dt-bindings/thermal/thermal.h>
#include <dt-bindings/soc/rtk_trustzone.h>
#include "rtl9607F-soc-clks.dtsi"
#include "rtl9607F-pe.dtsi"
#include "rtl9607F-crypto.dtsi"

#define CA_NE_DDR_COHERENT_BASE 0x0bc48000
#define CA_NE_DDR_COHERENT_SIZE 0x00020000
#define CA_NE_DDR_NONCACHE_BASE 0x09000000
#define CA_NE_DDR_NONCACHE_SIZE 0x014D4000
#ifdef CONFIG_RTK_NE_MEM_OVERWRITE
#undef CA_NE_DDR_COHERENT_BASE
#undef CA_NE_DDR_NONCACHE_BASE
#undef CA_NE_DDR_NONCACHE_SIZE
#define CA_NE_DDR_COHERENT_BASE CONFIG_RTK_NE_DDR_COHERENT_BASE
#define CA_NE_DDR_NONCACHE_BASE CONFIG_RTK_NE_DDR_NONCACHE_BASE
#define CA_NE_DDR_NONCACHE_SIZE CONFIG_RTK_NE_DDR_NONCACHE_SIZE
#endif

/ {
	chosen {
		kaslr-seed = <0x35780211 0x9617CDEF>;
	};

	arm-pmu {
		compatible = "arm,cortex-a55-pmu";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_HIGH>;
	};

	dsu-pmu-0 {
		compatible = "arm,dsu-pmu";
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI IRQ_GLB_ARM_CLUSTERPPMUIRQ IRQ_TYPE_LEVEL_HIGH>;
		cpus = <&cpu0>, <&cpu1>;
	};

	/* explained in Documentation/devicetree/bindings/arm/cpus.txt */
	/* topology explained in Documentation/devicetree/bindings/arm/topology.txt */
	/* TODO: cpufreq voltage and freq scaling, see Documentation/devicetree/bindings/cpufreq/cpufreq-dt.txt  */

	thermal: thermal@0xf4320294 {
		compatible = "cortina,thermal-sensor";
		reg = <0 0xf4320294 0 0x10>;
		status = "okay";
		tms-reg-a = <0x07f80000>;       /* Thermal parameter A */
		tms-reg-b = <0x00374000>;       /* Thermal parameter B */
		#thermal-sensor-cells = <0>;
		deviation = <2000>;
	};

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "arm,cortex-a55", "arm,armv8";
			device_type = "cpu";
			reg = <0x0 0x0>;
			enable-method = "psci";
			clocks = <&cpu_daemon_clk>;
			clock-names = "cpu";
			clock-latency = <300000>;
			operating-points =
				<1200000 1000000>,
				<1100000 1000000>,
				<1000000 1000000>,
				<800000 1000000>,
				<600000 1000000>,
				<500000 1000000>;
			#cooling-cells = <2>; /* min followed by max */
		};
		cpu1: cpu@100 {
			compatible = "arm,cortex-a55", "arm,armv8";
			device_type = "cpu";
			reg = <0x0 0x100>;
			enable-method = "psci";
			clocks = <&cpu_daemon_clk>;
			clock-names = "cpu";
			clock-latency = <300000>;
			operating-points =
				<1200000 1000000>,
				<1100000 1000000>,
				<1000000 1000000>,
				<800000 1000000>,
				<600000 1000000>,
				<500000 1000000>;
			#cooling-cells = <2>; /* min followed by max */
		};

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};
				core1 {
					cpu = <&cpu1>;
				};
			};
		};
	};

	thermal-zones {
		cpu_thermal: cpu-thermal {
			polling-delay-passive = <500>; /* milliseconds */
			polling-delay = <3000>; /* milliseconds */

			thermal-sensors = <&thermal>;
#if 0
			trips {
				cpu_crit0: cpu-crit0 { /* system power down */
						temperature = <125000>; /* millicelsius */
						hysteresis = <0>; /* millicelsius */
						type = "critical";
				};
			};

			cooling-maps {
				map0 {
						trip = <&cpu_crit0>;
						cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
#endif
		};
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	gic: interrupt-controller@4f8000000 {
		compatible = "arm,gic-v3";
		#interrupt-cells = <3>;
		interrupt-controller;
		#redistributor-regions = <1>;
		reg = <0x00000004 0xF8000000 0 0x10000>,
			<0x00000004 0xF8040000 0 0x80000>;
		interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
	};

	apb_pclk: g3_apb_pclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <125000000>;
	};

#ifdef CONFIG_OPTEE
	firmware {
		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};
	};
#endif

	/* Reserver memory region for Hash/FBM/NE and etc.
	 * Fixme when NE team finalize size and offset
	 */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

				ddr_cache_reserved: ddr_cache_buffer@CA_NE_DDR_COHERENT_BASE {
						reg = <0x00000000 CA_NE_DDR_COHERENT_BASE 0x0 CA_NE_DDR_COHERENT_SIZE>;    /* reserved memory area in DDR $-coherent */
				};

				ddr_noncache_reserved: ddr_noncache_buffer@CA_NE_DDR_NONCACHE_BASE {
						 reg = <0x00000000 CA_NE_DDR_NONCACHE_BASE 0x0 CA_NE_DDR_NONCACHE_SIZE>;    /* reserved memory area in DDR non-$cable */
				};
#ifdef CONFIG_OPTEE
		/* Hard code in BL31 and 32, linux/driver/tee takes this value from bl32 */
		tee_shmem: tee_shmem@1{
						reg = <0x00000000 TZ_OPTEE_SHMEM_PADDR 0x0 TZ_OPTEE_SHMEM_SIZE>;  /* 1MB as share mem between BL32 and BL33 */
				};
		tz_pool: tz_buffer@2 {
			 /* 16MB , BL32 is add in */
			reg = <0x00000000 TZ_POOL_PADDR_WITH_TEE 0x0 TZ_POOL_SIZE_WITH_TEE>;
			no-map;
		};
#else
		tz_pool: tz_buffer{
			/* 256KB is enough for BL31. Expand  here if BL32 is add in */
			reg = <0x00000000 TZ_POOL_PADDR_WITHOUT_TEE 0x0 TZ_POOL_SIZE_WITHOUT_TEE>;
			no-map;
		};
#endif
#if 0 /* Enable only if using DRAM */
		pstore_buf: pstore_buf@0xEF00000{
			/* reserved 1MB for kernel pstore persistent ram function */
			no-map;
			reg = <0x00000000 0xEF00000 0x0 0x100000>;
		};
#endif

	};

	/* Block Reset, GLOBAL_BLOCK_RESET  */
	block_rst: reset-controller@0xf43200a0 {
		compatible = "cortina,rst-mgr";
		reg = <0x0 0xf43200a0 0x0 0x04>;
		#reset-cells = <1>;
	};

	block_ext_rst: reset-controller@0xf43200a4 {
		compatible = "cortina,rst-mgr";
		reg = <0x0 0xf43200a4 0x0 0x04>;
		#reset-cells = <1>;
	};

	/* pon Reset */
	pon_rst: reset-controller@0xf432009c {
			compatible = "cortina,rst-mgr";
			reg = <0x0 0xf432009c 0x0 0x04>;
			#reset-cells = <1>;
	};

	/* DPHY Reset */
	dphy_rst: reset-controller@0xf43200a8 {
		compatible = "cortina,rst-mgr";
		reg = <0x0 0xf43200a8 0x0 0x04>;
		#reset-cells = <1>;
	};

	pe_reset: pe_reset{
		compatible = "rtk,elnath-pe-reset";
		duration-ms = <100>;
		#reset-cells = <1>;
		clocks = <&gate_offload0_clk &gate_offload1_clk &gate_offload2_clk>;
	};

	otp: otp@0xfff80300 {
		compatible = "cortina,cortina-otp";
		#address-cells = <1>;
		#size-cells = <1>;
		reg = <0x0 0xfff80300 0x0 0x100>;
		ngroups = <256>;

		redundant;


		uuid: uuid@0xB4 {
			reg = <0xB4 0x4>;
		};
		hvsid: hvsid@0xB8 {
			reg = <0xB8 0x4>;
		};

		phy_param: param@0xC0 {
			reg = <0xC0 0x4>;
		};

		phy_patch: patch@0xC4 {
			reg = <0xC4 0x10>;
		};
		phy_calibration: calib@0xD4 {
			reg = <0xD4 0x20>;
		};
	};
	/* Peripheral interrupts */
	per_ictl: per_ictl@0xf4329004  {
				compatible = "realtek,elnath-per-ictl";
				reg = <0x0 0xf4329004 0x0 0x10>;
				interrupt-controller;
				#interrupt-cells = <1>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI IRQ_GLB_PERI IRQ_TYPE_LEVEL_HIGH>;
				export-irq;
	};

	/* DMA SSP 0 interrupts */
	dma_ssp_ictl0: dma_ssp_ictl@f7001e08 {
				compatible = "cortina,per-ictl";
				reg = <0x0 0xf7001e08 0x0 0x8>;
				interrupt-controller;
				#interrupt-cells = <1>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI IRQ_GLB_DMA_SSP_0 IRQ_TYPE_LEVEL_HIGH>;
	};

	/* DMA LSO interrupts */
	dma_lso_ictl: dma_lso_ictl@0xf7001e00 {
								compatible = "cortina,per-ictl";
								reg = <0x0 0xf7001e00 0x0 0x08>;
								interrupt-controller;
								#interrupt-cells = <1>;
								interrupt-parent = <&gic>;
								interrupts = <GIC_SPI IRQ_GLB_DMA_LSO_0 IRQ_TYPE_LEVEL_HIGH>;
		};

	/* NE interrupts */
	ne_ictl: ne_ictl@0xf4320194  {
				compatible = "cortina,per-ictl";
				reg = <0x0 0xf4320194  0x0 0x10>;
				interrupt-controller;
				#interrupt-cells = <1>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI IRQ_GLB_NE IRQ_TYPE_LEVEL_HIGH>;
	};

		/* NI interrupt for NI port PTP timestamp event */
	ni_hv_ictl: ni_hv_ictl@0xf430a40c {
		    compatible = "cortina,per-ictl";
		    reg = <0x00000000 0xf430a40c 0x0 0x8>;
		    interrupt-controller;
		    #interrupt-cells = <1>;
		    interrupt-parent = <&ne_ictl>;
		    interrupts = <0>;
	};
	/* clocks explained here Documentation/devicetree/bindings/clock/clock-bindings.txt */
	/* TODO */
	/* ARM V8 timer explained here /Documentation/devicetree/bindings/arm/arch_timer.txt */
	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&gic>;
		/* interrupts values below are bit position and ordering is listed as secure, non-secure, virtual and hypervisor modes */
		interrupts = <1 13 0xff08>,
			     <1 14 0xff08>,
			     <1 11 0xff08>,
			     <1 10 0xff08>;
		/* If no clock-frequency, arm_arch_timer.c will get it from CNTFRQ_EL0 */
		/* CNTFRQ_EL0 should be assigned on BL2 correctly */
		/* clock-frequency = <25000000>; */
	};

	pinctrl: pinctrl@0xf4320428 {
		compatible = "rtk,elnath-pinctrl";
		reg = <0x0 0xf4320428 0x0 0x0C>,
			  <0x0 0xf4320130 0x0 0x14>;
		pins_led0: pins_led0 {
			mux {
				function = "led0";
				groups = "led0_group";
			};
		};

		pins_led0_q: pins_led0_q {
			mux {
				function = "led0";
				groups = "led0_q_group";
			};
		};

		pins_led1: pins_led1 {
			mux {
				function = "led1";
				groups = "led1_group";
			};
		};

		pins_led1_q: pins_led1_q {
			mux {
				function = "led1";
				groups = "led1_q_group";
			};
		};

		pins_led2: pins_led2 {
			mux {
				function = "led2";
				groups = "led2_group";
			};
		};

		pins_led2_q: pins_led2_q {
			mux {
