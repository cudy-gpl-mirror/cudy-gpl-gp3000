#include "../../../../../include/generated/autoconf.h"
#include <dt-bindings/soc/rtk_taurus_irqs.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/reset/cortina,rst-mgr.h>
#include <dt-bindings/phy/phy-rtl8277c.h>
#include <dt-bindings/thermal/thermal.h>
#include <dt-bindings/soc/rtk_trustzone.h>
#include "rtl8277C-atu.dtsi"
#include "../../../../../drivers/net/ethernet/realtek/rtl86900/FleetConntrackDriver/pe/dts/rtl8277C-pe.dtsi"

#define CA_NE_DDR_COHERENT_BASE 0x0bc48000
#define CA_NE_DDR_COHERENT_SIZE 0x00010000
#define CA_NE_DDR_NONCACHE_BASE 0x09000000
#ifdef CONFIG_RTK_NE_DDR_NONCACHE_SIZE
#define CA_NE_DDR_NONCACHE_SIZE CONFIG_RTK_NE_DDR_NONCACHE_SIZE
#else
#define CA_NE_DDR_NONCACHE_SIZE 0x01A50000
#endif

/ {
	arm-pmu {
		compatible = "arm,cortex-a55-pmu";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_HIGH>;
	};

	dsu-pmu-0 {
		compatible = "arm,dsu-pmu";
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI IRQ_GLB_ARM_CLUSTERPPMUIRQ IRQ_TYPE_LEVEL_HIGH>;
		cpus = <&cpu0>, <&cpu1>, <&cpu2>,  <&cpu3>;
	};

	/* explained in Documentation/devicetree/bindings/arm/cpus.txt */
	/* topology explained in Documentation/devicetree/bindings/arm/topology.txt */
	/* TODO: cpufreq voltage and freq scaling, see Documentation/devicetree/bindings/cpufreq/cpufreq-dt.txt  */

	thermal: thermal@0xf4320264 {
		compatible = "cortina,thermal-sensor";
		reg = <0 0xf4320264 0 0x10>;
		status = "okay";
		tms-reg-a = <0x07f80000>;       /* Thermal parameter A */
		tms-reg-b = <0x00374000>;       /* Thermal parameter B */
		#thermal-sensor-cells = <0>;
		deviation = <5000>;
	};

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "arm,cortex-a55", "arm,armv8";
			device_type = "cpu";
			reg = <0x0 0x0>;
			clocks = <&cpu_daemon_clk>;
			clock-names = "cpu";
			operating-points =
				<1200000 1000000>,
				<1100000 1000000>,
				<1000000 1000000>,
				<900000 1000000>,
				<800000 1000000>,
				<700000 1000000>,
				<625000 1000000>,
				<400000 1000000>;
			enable-method = "psci";
			#cooling-cells = <2>; /* min followed by max */
		};
		cpu1: cpu@100 {
			compatible = "arm,cortex-a55", "arm,armv8";
			device_type = "cpu";
			reg = <0x0 0x100>;
			clocks = <&cpu_daemon_clk>;
			clock-names = "cpu";
			operating-points =
				<1200000 1000000>,
				<1100000 1000000>,
				<1000000 1000000>,
				<900000 1000000>,
				<800000 1000000>,
				<700000 1000000>,
				<625000 1000000>,
				<400000 1000000>;
			enable-method = "psci";
			#cooling-cells = <2>; /* min followed by max */
		};
		cpu2: cpu@200 {
			compatible = "arm,cortex-a55", "arm,armv8";
			device_type = "cpu";
			reg = <0x0 0x200>;
			clocks = <&cpu_daemon_clk>;
			clock-names = "cpu";
			operating-points =
				<1200000 1000000>,
				<1100000 1000000>,
				<1000000 1000000>,
				<900000 1000000>,
				<800000 1000000>,
				<700000 1000000>,
				<625000 1000000>,
				<400000 1000000>;
			enable-method = "psci";
			#cooling-cells = <2>; /* min followed by max */
                };
			cpu3: cpu@300 {
			compatible = "arm,cortex-a55", "arm,armv8";
			device_type = "cpu";
			reg = <0x0 0x300>;
			clocks = <&cpu_daemon_clk>;
			clock-names = "cpu";
			operating-points =
				<1200000 1000000>,
				<1100000 1000000>,
				<1000000 1000000>,
				<900000 1000000>,
				<800000 1000000>,
				<700000 1000000>,
				<625000 1000000>,
				<400000 1000000>;
			enable-method = "psci";
			#cooling-cells = <2>; /* min followed by max */
                };
		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};
				core1 {
					cpu = <&cpu1>;
				};
				core2 {
                                        cpu = <&cpu2>;
                                };
                                core3 {
                                        cpu = <&cpu3>;
                                };
			};
		};
	};

	thermal-zones {
		cpu_thermal: cpu-thermal {
			polling-delay-passive = <500>; /* milliseconds */
			polling-delay = <3000>; /* milliseconds */

			thermal-sensors = <&thermal>;

#if 0
			trips {
				cpu_crit0: cpu-crit0 { /* system power down */
						temperature = <125000>; /* millicelsius */
						hysteresis = <0>; /* millicelsius */
						type = "critical";
				};
			};

			cooling-maps {
				map0 {
						trip = <&cpu_crit0>;
						cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
#endif
		};
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	gic: interrupt-controller@4f8000000 {
		compatible = "arm,gic-v3";
		#interrupt-cells = <3>;
		interrupt-controller;
		#redistributor-regions = <1>;
		reg = <0x00000004 0xF8000000 0 0x10000>,
			<0x00000004 0xF8040000 0 0x80000>;
		interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
	};

	apb_pclk: g3_apb_pclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <125000000>;
	};
#ifdef CONFIG_OPTEE
	firmware {
		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};
	};
#endif

	/* Reserver memory region for Hash/FBM/NE and etc.
	 * Fixme when NE team finalize size and offset
	 */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

                ddr_cache_reserved: ddr_cache_buffer@CA_NE_DDR_COHERENT_BASE {
                        reg = <0x00000000 CA_NE_DDR_COHERENT_BASE 0x0 CA_NE_DDR_COHERENT_SIZE>;    /* reserved memory area in DDR $-coherent */
                };

                ddr_noncache_reserved: ddr_noncache_buffer@CA_NE_DDR_NONCACHE_BASE {
                         reg = <0x00000000 CA_NE_DDR_NONCACHE_BASE 0x0 CA_NE_DDR_NONCACHE_SIZE>;    /* reserved memory area in DDR non-$cable */
                };
#ifdef CONFIG_OPTEE
		tz_smc_buf: tz_smc_buf@0{
			reg = <0x00000000 TZ_SMC_BUF_PADDR_WITH_TEE 0x0 TZ_SMC_BUF_SIZE>; /* 1KB as the msg buff of smc call */
			no-map;
		};
		tee_shmem: tee_shmem@1{							/* Hard code in BL31 and 32, linux/driver/tee takes this value from bl32 */
                        reg = <0x00000000 TZ_OPTEE_SHMEM_PADDR 0x0 TZ_OPTEE_SHMEM_SIZE>;  /* 1MB as share mem between BL32 and BL33 */
                };
		tz_pool: tz_buffer@2 {
			/* SECURE DRAM REGION, SIZE BL31 + BL32 */
			reg = <0x00000000 TZ_POOL_PADDR_WITH_TEE 0x0 TZ_POOL_SIZE_WITH_TEE>;
			no-map;
                };
#else
		tz_pool: tz_buffer{
			reg = <0x00000000 TZ_POOL_PADDR_WITHOUT_TEE 0x0 TZ_POOL_SIZE_WITHOUT_TEE>; /* 256KB is enought for BL31. Expand  here if BL32 is add in */
			no-map;
		};
		tz_smc_buf: tz_smc_buf{
			reg = <0x00000000 TZ_SMC_BUF_PADDR_WITHOUT_TEE 0x0 TZ_SMC_BUF_SIZE>; /* 4KB as the msg buff of smc call */
			no-map;
		};
#endif
#if 0 /* Enable only if using DRAM */
		pstore_buf: pstore_buf@0xEF00000{
			no-map;
			reg = <0x00000000 0xEF00000 0x0 0x100000>; /* reserved 1MB for kernel pstore persistent ram function */
		};
#endif

#if 0 // # CONFIG_CORTINA_HWSEM is not set , # CONFIG_CORTINA_IPC2RCPU is not set , # CONFIG_CORTINA_PELOG is not set

		ipc_reserved: ipc_shm@0x1000000 {
			reg = <0x00000000 0x1000000 0x0 0x4800>;
		};

		pelog_reserved: pelog_shm@0x1010000 {
			reg = <0x00000000 0x1010000 0x0 0x1000>,
				<0x00000000 0x1113000 0x0 0x1000>;
		};
#endif
#if 0 /* VOIP voip.dtsi will reserver by itself  */
		taroko0_reserved: taroko0@0x2000000 {
			reg = <0x00000000 0x2000000 0x0 0x400000>;
		};

		taroko1_reserved: taroko0@0x3000000 {
			reg = <0x00000000 0x3000000 0x0 0x400000>;
		};
		/* NOTICE: check voip.dtsi */
#endif
	};

	/* Block Reset */
	block_rst: reset-controller@0xf4320098 {
		compatible = "cortina,rst-mgr";
		reg = <0x0 0xf4320098 0x0 0x04>;
		#reset-cells = <1>;
	};

	block_ext_rst: reset-controller@0xf432009c {
		compatible = "cortina,rst-mgr";
		reg = <0x0 0xf432009c 0x0 0x04>;
		#reset-cells = <1>;
	};

	/* pon Reset */
	pon_rst: reset-controller@0xf4320094 {
			compatible = "cortina,rst-mgr";
			reg = <0x0 0xf4320094 0x0 0x04>;
			#reset-cells = <1>;
	};

	/* DPHY Reset */
	dphy_rst: reset-controller@0xf43200a0 {
		compatible = "cortina,rst-mgr";
		reg = <0x0 0xf43200a0 0x0 0x04>;
		#reset-cells = <1>;
	};

	/* Packet Engine Reset */
	pe_reset: pe_reset{
		compatible = "rtk,taurus-pe-reset";
		duration-ms = <100>;
		#reset-cells = <1>;
	};

	otp: otp@0xfff80300 {
		compatible = "cortina,cortina-otp";
		#address-cells = <1>;
		#size-cells = <1>;
		reg = <0x0 0xfff80300 0x0 0x100>;
		ngroups = <256>;

		redundant;


		uuid: uuid@0x74 {
			reg = <0x74 0x4>;
		};
		hvsid: hvsid@0x78 {
			reg = <0x78 0x4>;
		};

		phy_param: param@0x80 {
			reg = <0x80 0x4>;
		};

		phy_patch: patch@0x84 {
			reg = <0x84 0x10>;
		};
		phy_calibration: calib@0x94 {
			reg = <0x94 0x20>;
		};
	};

	/* Peripheral interrupts */
	per_ictl: per_ictl@f4329004  {
				compatible = "cortina,per-ictl";
				reg = <0x0 0xf4329004  0x0 0x10>;
				interrupt-controller;
				#interrupt-cells = <1>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI IRQ_GLB_PERI IRQ_TYPE_LEVEL_HIGH>;
				export-irq;
	};

	/* DMA SSP 0 interrupts */
	dma_ssp_ictl0: dma_ssp_ictl@f7001e08 {
				compatible = "cortina,per-ictl";
				reg = <0x0 0xf7001e08 0x0 0x8>;
				interrupt-controller;
				#interrupt-cells = <1>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI IRQ_GLB_DMA_SSP_0 IRQ_TYPE_LEVEL_HIGH>;
	};

	/* DMA LSO interrupts */
	dma_lso_ictl: dma_lso_ictl@0xf7001e00 {
                                compatible = "cortina,per-ictl";
                                reg = <0x0 0xf7001e00 0x0 0x08>;
                                interrupt-controller;
                                #interrupt-cells = <1>;
                                interrupt-parent = <&gic>;
                                interrupts = <GIC_SPI IRQ_GLB_DMA_LSO_0 IRQ_TYPE_LEVEL_HIGH>;
        };

	/* NE interrupts */
	ne_ictl: ne_ictl@0xf4320164  {
				compatible = "cortina,per-ictl";
				reg = <0x0 0xf4320164  0x0 0x10>;
				interrupt-controller;
				#interrupt-cells = <1>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI IRQ_GLB_NE IRQ_TYPE_LEVEL_HIGH>;
	};

        /* NI interrupt for NI port PTP timestamp event */
	ni_hv_ictl: ni_hv_ictl@0xf430a414 {
		    compatible = "cortina,per-ictl";
		    reg = <0x00000000 0xf430a414 0x0 0x8>;
		    interrupt-controller;
		    #interrupt-cells = <1>;
		    interrupt-parent = <&ne_ictl>;
		    interrupts = <0>;
	};

	/* clocks explained here Documentation/devicetree/bindings/clock/clock-bindings.txt */
	/* TODO */
	/* ARM V8 timer explained here /Documentation/devicetree/bindings/arm/arch_timer.txt */
	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&gic>;
		/* interrupts values below are bit position and ordering is listed as secure, non-secure, virtual and hypervisor modes */
		interrupts = <1 13 0xff08>,
			     <1 14 0xff08>,
			     <1 11 0xff08>,
			     <1 10 0xff08>;
		clock-frequency = <25000000>; /* Joe confirmed external timer frequence is 25MHz */
	};

	pinctrl: pinctrl@0xf43200f0 {
		compatible = "cortina,g3-pinctrl";
		reg = <0x0 0xf43200f0 0x0 0x24>;

		uart0_hw_fc: uart0_active {
			data_signals {
				pins = "PMUX_003";
				function = "multi-fn";
			};
		};
		uart2_default: uart2_active {
			data_signals {
				pins = "GPIO_000", "GPIO_001", "PMUX_004";
				function = "multi-fn";
			};
		};
		uart3_default: uart3_active {
			data_signals {
				pins = "GPIO_002", "GPIO_003", "PMUX_005";
				function = "multi-fn";
			};
		};
		spi_cs1: spi_cs1 {
			data_signals {
				pins = "GPIO_004", "PMUX_006";
				function = "multi-fn";
			};
		};
		spi_cs2: spi_cs2 {
			data_signals {
				pins = "GPIO_005", "PMUX_007";
				function = "multi-fn";
			};
		};
		spi_cs3: spi_cs3 {
			data_signals {
				pins = "GPIO_006", "PMUX_008";
				function = "multi-fn";
			};
		};
		spi_cs4: spi_cs4 {
			data_signals {
				pins = "GPIO_007", "PMUX_009";
				function = "multi-fn";
			};
		};
		led_ctrl_default: led_ctrl_active {
			data_signals {
				pins = "GPIO_011", "GPIO_012", "PMUX_019";
				function = "multi-fn";
			};
		};

		mdio_default: mdio_default {
			data_signals {
				pins = "GPIO_402", "GPIO_403", "PMUX_111";
				function = "multi-fn";
			};
		};

		i2c0_default: i2c0_default {
			data_signals {
				pins = "GPIO_204", "GPIO_205", "PMUX_120";
				function = "multi-fn";
			};
		};

		rgmii_default: rgmii_default {
			data_signals {
				pins = "GPIO_313", "GPIO_314", "GPIO_315", "GPIO_316",\
					"GPIO_317", "GPIO_318", "GPIO_319",	"GPIO_320", \
					"GPIO_321", "GPIO_322", "GPIO_323", "GPIO_324", "PMUX_114";
				function = "multi-fn";
			};
		};

		voip_spi: voip_spi {
			data_signals {
				pins = "GPIO_200", "GPIO_201", "GPIO_202", "GPIO_203", "PMUX_106";
				function = "multi-fn";
			};
		};

		ssp: ssp {
			data_signals {
				pins = "GPIO_206", "GPIO_207", "GPIO_208", "GPIO_209", "GPIO_210", "GPIO_211", "PMUX_104";
				function = "multi-fn";
			};
		};
		spidma: spidma {
			data_signals {
				pins = "GPIO_006", "GPIO_007", "GPIO_013", "GPIO_014", "PMUX_105";
				function = "multi-fn";
			};
		};
	};

	hw_led_ctrl: led-controller@f43201bc {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "realtek,rtk_port-leds";
		reg = <0x0 0xf43201bc 0x0 0x44>;
		reg-names = "led_ctrl";
		status = "disabled";
		hw-blink-rate1 = <32>;
		hw-blink-rate2 = <64>;

		num-ports = <4>;

		hw_led0: hw_led@0 {
			reg = <0>;
			label = "LED_Port0";
			port = <0>;
			mode = <1>;	// 0: HW blink AND mode
						// 1: HW blink OR mode
						// 2: SW mode
			default-state = "off";
			active-low;
			blinking,hw-rx;
			blinking,hw-tx;
			on,sw;
		};
		hw_led1: hw_led@1 {
			reg = <1>;
			label = "LED_Port1";
			port = <1>;
			mode = <1>;	// 0: HW blink AND mode
						// 1: HW blink OR mode
						// 2: SW mode
			default-state = "off";
			active-low;
			blinking,hw-rx;
			blinking,hw-tx;
			on,sw;
		};
		hw_led2: hw_led@2 {
			reg = <2>;
			label = "LED_Port2";
			port = <2>;
			mode = <1>;	// 0: HW blink AND mode
						// 1: HW blink OR mode
						// 2: SW mode
			default-state = "off";
			active-low;
			blinking,hw-rx;
			blinking,hw-tx;
			on,sw;
		};
		hw_led3: hw_led@3 {
			reg = <3>;
			label = "LED_Port3";
			port = <3>;
			mode = <1>;	// 0: HW blink AND mode
						// 1: HW blink OR mode
						// 2: SW mode
			default-state = "off";
			active-low;
			blinking,hw-rx;
			blinking,hw-tx;
			on,sw;
		};
	};

	uart0: uart@f43291b0 { /* console */
		device_type = "serial";
		compatible = "cortina,serial";
		reg = <0x00000000 0xf43291b0 0x0 0x30>; /* TODO - update when memory map available */
		clocks = <&apb_pclk>;
		interrupts = <GIC_SPI IRQ_GLB_UART0 IRQ_TYPE_LEVEL_HIGH>; /* TODO - update when interrupt map available */
		//pinctrl-0 = <&uart0_hw_fc>;		/* Enable this only if need UART0 HW flow contrl */
		//pinctrl-names = "default";
		wakeup-source;
	};

	uart1: uart@f43291e0 {
		device_type = "serial";
		compatible = "cortina,serial";
		reg = <0x00000000 0xf43291e0 0x0 0x30>; /* TODO - update when memory map available */
		clocks = <&apb_pclk>;
		interrupts = <GIC_SPI IRQ_GLB_UART1 IRQ_TYPE_LEVEL_HIGH>; /* TODO - update when interrupt map available */
	};

	uart2: uart@f4329800 {
		compatible = "ns16550a";
		reg = <0x0 0xf4329800 0x0 0x40>;
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI IRQ_GLB_DMA_UART0 IRQ_TYPE_LEVEL_HIGH>;
		clock-frequency = <100000000>;
		reg-shift = <2>;
		reg-io-width = <4>;
		pinctrl-0 = <&uart2_default>;
		pinctrl-names = "default";
	};

	uart3: uart@f4329c00 {
		compatible = "ns16550a";
		reg = <0x0 0xf4329c00 0x0 0x40>;
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI IRQ_GLB_DMA_UART1 IRQ_TYPE_LEVEL_HIGH>;
		clock-frequency = <100000000>;
		reg-shift = <2>;
		reg-io-width = <4>;
		pinctrl-0 = <&uart3_default>;
		pinctrl-names = "default";
	};

	spare_reg: spare@f432945c {
		compatible = "realtek,rtk_spare_reg";
		reg = <0x0 0xf432945c 0x0 0x4>;
	};

	gpio-controller@f43292c0 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "cortina,ca77xx-gpio";
		reg = <0x0 0xf43292c0 0x0 0xb4>, /* PER_GPIO0_CFG */
		      <0x0 0xf4320100 0x0 0x14>; /* GLOBAL_GPIO_MUX_0 */
		id = <0>;

		/* bank 0 with an interrupt */
		gpio0: bank@0 {
			gpio-controller;
			interrupt-controller;
			reg = <0>;
			ngpios = <16>;
			#gpio-cells = <2>;
			#interrupt-cells = <2>;
			interrupt-parent = <&per_ictl>;
			interrupts = <IRQ_PER_GPIO0>;
			gpio-ranges = <&pinctrl 0 0 32>;
		};

		/* bank 1 with an interrupt */
		gpio1: bank@1 {
			gpio-controller;
			interrupt-controller;
			reg = <1>;
			ngpios = <17>;
			#gpio-cells = <2>;
			#interrupt-cells = <2>;
			interrupt-parent = <&per_ictl>;
			interrupts = <IRQ_PER_GPIO1>;
			gpio-ranges = <&pinctrl 0 32 32>;
		};

		/* bank 2 without interrupt */
		gpio2: bank@2 {
			gpio-controller;
			interrupt-controller;
			reg = <2>;
			ngpios = <12>;
			#gpio-cells = <2>;
			#interrupt-cells = <2>;
			interrupt-parent = <&per_ictl>;
			interrupts = <IRQ_PER_GPIO2>;
			gpio-ranges = <&pinctrl 0 64 32>;
		};

		/* bank 3 without interrupt */
		gpio3: bank@3 {
			gpio-controller;
			interrupt-controller;
			reg = <3>;
			ngpios = <25>;
			#gpio-cells = <2>;
			#interrupt-cells = <2>;
			interrupt-parent = <&per_ictl>;
			interrupts = <IRQ_PER_GPIO3>;
			gpio-ranges = <&pinctrl 0 96 32>;
		};

		/* bank 4 without interrupt */
		gpio4: bank@4 {
			gpio-controller;
			interrupt-controller;
			reg = <4>;
			ngpios = <17>;
			#gpio-cells = <2>;
			#interrupt-cells = <2>;
			interrupt-parent = <&per_ictl>;
			interrupts = <IRQ_PER_GPIO4>;
			gpio-ranges = <&pinctrl 0 128 32>;
		};
	};

	/* explained in Documentation/devicetree/bindings/phy/ca77xx-phy.txt */
	glb_phy: phy@0xf43200c4 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "realtek,taurus-phy";
		reg = <0x0 0xf43200c4 0x0 0x20>,
		      <0x0 0xf432036c 0x0 0x4>;
		reg-names = "control", "power";

		s0_pcie_phy0: phy@PHY_S0_PCIE0 {
			reg = <PHY_S0_PCIE0>;
			#phy-cells = <0>;
		};

		s0_pcie_phy1: phy@PHY_S0_PCIE1 {
			reg = <PHY_S0_PCIE1>;
			#phy-cells = <0>;
		};

		s0_rxaui_phy: phy@PHY_S0_RXAUI {
			reg = <PHY_S0_RXAUI>;
			#phy-cells = <0>;
		};

		s1_pcie_phy0: phy@PHY_S1_PCIE0 {
			reg = <PHY_S1_PCIE0>;
			#phy-cells = <0>;
		};

		s1_pcie_phy1: phy@PHY_S1_PCIE1 {
			reg = <PHY_S1_PCIE1>;
			#phy-cells = <0>;
		};

		s2_pcie_phy0: phy@PHY_S2_PCIE0 {
			reg = <PHY_S2_PCIE0>;
			#phy-cells = <0>;
		};

		s2_usb_phy: phy@PHY_S2_USB {
			reg = <PHY_S2_USB>;
			#phy-cells = <0>;
		};

		s3_usb_phy: phy@PHY_S3_USB {
			reg = <PHY_S3_USB>;
			#phy-cells = <0>;
		};

		s3_sgmii_phy: phy@PHY_S3_SGMII {
			reg = <PHY_S3_SGMII>;
			#phy-cells = <0>;
			serdes-reg = <0x0 0xf4600000 0x0 0x1000>;
		};

	};



	/* Synopsis Designware PCIe interface */
	/* explained in Documentation/devicetree/bindings/pci/ca77xx-pcie.txt */
	pcie0: pcie@f4325000 {
		compatible = "cortina,venus-pcie";
		reg = <0x0 0xf4325000 0x0 0x00000400>,
		      <0x0 0xa0000000 0x0 0x00001000>,
		      <0x0 0xa0001000 0x0 0x00002000>,
		      <0x0 0xa0300000 0x0 0x00100000>,
