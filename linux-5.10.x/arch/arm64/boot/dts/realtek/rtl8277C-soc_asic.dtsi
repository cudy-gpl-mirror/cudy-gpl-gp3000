	soc {
		compatible = "realtek,taurus";
		reg = <0x00000000 0xf4320000 0x0 0x4>,		/* GLOBAL_JTAG_ID */
		      <0x00000000 0xf4320200 0x0 0x44>,		/* GLOBAL_CPLL_DIV */
		      <0x00000000 0xf43200ac 0x0 0x4>;		/* GLOBAL_STRAP */
		reg-names = "JTAG_ID", "CLOCK", "STRAP";
	};

	ethernet:ethernet@f4300000 {
		compatible = "cortina,ni-interface";

		reg = <0x00000004 0xf4300000 0x0 0x10000>,	/* reserved memory area for HV NE(APB0) module registers */
		      <0x00000004 0xf4320164 0x0 0x10>,		/* reserved memory area for Global Network Engine Interrupt registers */
		      <0x00000004 0xf4329118 0x0 0x48>, 	/* reserved memory area for MDIO registers */
		      <0x00000000 0xf4500000 0x0 0x2000>,	/* reserved memory area for XRAM */
		      <0x00000004 0xf7001000 0x0 0x1000>,	/* reserved memory area for DMA LSO extend to DMA AFT */
                      <0x00000000 0x80000000 0x0 0x3c000>,      /* reserved memory area in SRAM */
                      <0x00000000 CA_NE_DDR_COHERENT_BASE 0x0 CA_NE_DDR_COHERENT_SIZE>,    /* reserved memory area in DDR $-coherent */
                      <0x00000001 CA_NE_DDR_NONCACHE_BASE 0x0 CA_NE_DDR_NONCACHE_SIZE>,    /* reserved memory area in DDR non-$cable */
                      <0x00000004 0xf5500000 0x0 0xc000>, /* reserved memory area in PON */
                      <0x00000004 0xf4320000 0x0 0x300>,	/* reserved memory area in PON GLB*/
                      <0x00000004 0xf432d000 0x0 0x20b8>,	/* reserved memory area for axi reoder*/
                      <0x00000004 0xf4600000 0x0 0x100000>,       /* reserved memory area for internal RTL8211 PHY registers */
		      <0x00000004 0xf550c000 0x0 0x1000>, /* reserved memory area in XFI */
		      <0x00000004 0xf433a000 0x0 0x2000>,       /* reserved memory area for SGMII HP/LP registers */
		      <0x00000004 0xf550d000 0x0 0x1000>,	/* reserded memory area for QX */
			  <0x00000004 0xf4700000 0x0 0x100>,	/* reserved memory area for GPHY wrapper */
			  <0x00000000 0x90301000 0x0 0x2000>,	/* reserved memory area for LDMA */
		      <0x00000004 0xf4333000 0x0 0x6000>;       /* reserved memory area for SDS registers */

		//interrupt-parent=<&ne_ictl>;
		//interrupts=<0>,					/* interupt for NI */
		//	   <4>;					/* interrupt for TQM */
		interrupt-parent=<&gic>;
                interrupts=<GIC_SPI IRQ_GLB_QM_CPU_FIFO0_REQ IRQ_TYPE_LEVEL_HIGH>,
                           <GIC_SPI IRQ_GLB_QM_CPU_FIFO1_REQ IRQ_TYPE_LEVEL_HIGH>,
                           <GIC_SPI IRQ_GLB_QM_CPU_FIFO2_REQ IRQ_TYPE_LEVEL_HIGH>,
                           <GIC_SPI IRQ_GLB_QM_CPU_FIFO3_REQ IRQ_TYPE_LEVEL_HIGH>,
                           <GIC_SPI IRQ_GLB_QM_CPU_FIFO4_REQ IRQ_TYPE_LEVEL_HIGH>,
                           <GIC_SPI IRQ_GLB_QM_CPU_FIFO5_REQ IRQ_TYPE_LEVEL_HIGH>,
                           <GIC_SPI IRQ_GLB_QM_CPU_FIFO6_REQ IRQ_TYPE_LEVEL_HIGH>,
                           <GIC_SPI IRQ_GLB_QM_CPU_FIFO7_REQ IRQ_TYPE_LEVEL_HIGH>,
                           <GIC_SPI IRQ_GLB_QM_CPU_REFILL_REQ_8  IRQ_TYPE_LEVEL_HIGH>,
                           <GIC_SPI IRQ_GLB_QM_CPU_REFILL_REQ_9  IRQ_TYPE_LEVEL_HIGH>,
                           <GIC_SPI IRQ_GLB_QM_CPU_REFILL_REQ_10 IRQ_TYPE_LEVEL_HIGH>,
                           <GIC_SPI IRQ_GLB_QM_CPU_REFILL_REQ_11 IRQ_TYPE_LEVEL_HIGH>,
                           <GIC_SPI IRQ_GLB_QM_CPU_REFILL_REQ_4  IRQ_TYPE_LEVEL_HIGH>,
                           <GIC_SPI IRQ_GLB_QM_CPU_REFILL_REQ_5  IRQ_TYPE_LEVEL_HIGH>,
                           <GIC_SPI IRQ_GLB_QM_CPU_REFILL_REQ_6  IRQ_TYPE_LEVEL_HIGH>,
                           <GIC_SPI IRQ_GLB_QM_CPU_REFILL_REQ_7  IRQ_TYPE_LEVEL_HIGH>;

		phys = <&s3_sgmii_phy>;
                phy-names = "sgmii-phy";

		nvmem-cells = <&phy_param>, <&phy_calibration>, <&phy_patch>;
		nvmem-cell-names = "param", "calibration", "phy_patch";

		resets = <&block_rst NI_RESET>, <&block_rst L2FE_RESET>, <&block_rst L2TM_RESET>, <&block_rst L3FE_RESET>, <&block_rst SDRAM_RESET>, <&block_rst TQM_RESET>, <&dphy_rst PHY_SDSIF_RESET>, <&dphy_rst PHY_SGMII_RESET>, <&block_rst PTP_TIMER_RESET>, <&pon_rst PTP_RESET>;
                reset-names = "ni_reset", "l2fe_reset", "l2tm_reset", "l3fe_reset", "sdram_reset", "tqm_reset", "phy_sdsif_reset", "phy_sgmii_reset", "ptp_timer_reset", "ptp_reset";

		memory-region = <&ddr_cache_reserved>, <&ddr_noncache_reserved>;

		//pon-gpio = <&gpio0 2 GPIO_ACTIVE_LOW>;
		//dyinggasp-gpio = <&gpio0 1 GPIO_ACTIVE_LOW>;

		/* should put here before any node definition */
	    /*    ni-sfi-int-gpio = <&gpio0 2 GPIO_ACTIVE_HIGH>; */

		eth0: ethernet@0 {
			local-mac-address = [ 00 00 00 00 00 00 ];
		};

		eth1: ethernet@1 {
			local-mac-address = [ 00 00 00 00 00 00 ];
		};

		pon: pon_ictl@0 {
			interrupt-parent = <&ne_ictl>;
			interrupts = <IRQ_NE_PON>;
	        };

		dma_lso_vp10_int: dma_lso_vp10_int@10{
			interrupt-parent = <&dma_lso_ictl>;
			interrupts = <10>;
			interrupt-names = "DMA_LSO_VP10_INT";
		};

		dma_lso_vp11_int: dma_lso_vp11_int@11{
			interrupt-parent = <&dma_lso_ictl>;
			interrupts = <11>;
			interrupt-names = "DMA_LSO_VP11_INT";
		};

		dma_lso_int: dma_lso_int@12{
			interrupt-parent = <&dma_lso_ictl>;
			interrupts = <12>;
			interrupt-names = "DMA_LSO_INT";
		};

		ne_qm_int: ne_qm_int@4{
                        interrupt-parent = <&ne_ictl>;
                        interrupts = <IRQ_NE_TQM>;
		};

		//rtk for dg int 
		dg_int: dg_int@24{
			interrupt-parent = <&per_ictl>;
			interrupts = <24>;
			interrupt-names = "DG_INT";
		};

                /* PTP interrupt for PTP timer rollover */
                ni_ptp: ni_ptp_ictl@0xf430439c {
                        compatible = "cortina,per-ictl";
                        interrupt-controller;
                        #interrupt-cells = <1>;
                        interrupt-parent = <&ne_ictl>;
                        interrupts = <5>;
                        };

		/* GPHY interrupts for NI ports */
                ni_gphy: ni_gphy_ictl@0 {
		        interrupt-parent = <&gic>;
		        interrupts = <GIC_SPI IRQ_GLB_GPHY_MAC_0 IRQ_TYPE_LEVEL_HIGH>,
			    <GIC_SPI IRQ_GLB_GPHY_MAC_1 IRQ_TYPE_LEVEL_HIGH>,
			    <GIC_SPI IRQ_GLB_GPHY_MAC_2 IRQ_TYPE_LEVEL_HIGH>,
			    <GIC_SPI IRQ_GLB_GPHY_MAC_3 IRQ_TYPE_LEVEL_HIGH>;
	        };

                ni_sfi_int: ni_sfi_int@0 {
		    interrupt-parent = <&ni_hv_ictl>;
		    interrupts = <22>;
		    interrupt-names = "SFI ITNT";
	        };

		ni_sfi_gpio_int: ni_sfi_los_int@0 {
                    interrupt-parent = <&gpio0>;
                    interrupts = <2 IRQ_TYPE_EDGE_BOTH>;
                    interrupt-names = "SFI LOS ITNT";
		};

		dying_gasp:dying_gasp@0{
                    interrupt-parent = <&per_ictl>;
                    interrupts = <24>;
                    interrupt-names = "DYING GASP";
	   };

		mdio:mdio {
			irq-handle = <&ni_gphy>;

			phy1:phy@1 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <1>;
			};
			phy2:phy@2 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <2>;
			};
			phy3:phy@3 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <3>;
			};
			phy4:phy@4 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <4>;
			};
		};
	};

	switchdev: switchdev@0 {
		compatible = "realtek,switchdev";
		ethernet_ports: ethernet-ports {
			rtksw_port0: port@0 {
				id = <0>;
				label = "port0";
				mac-address = [ 00 00 00 00 00 00 ];
				netdev-name = "eth0.2";
				phy-handle = <&phy1>;
				phy-mode = "rgmii";
			};
			rtksw_port1: port@1 {
				id = <1>;
				label = "port1";
				mac-address = [ 00 00 00 00 00 00 ];
				netdev-name = "eth0.3";
				phy-handle = <&phy2>;
				phy-mode = "rgmii";
			};
			rtksw_port2: port@2 {
				id = <2>;
				label = "port1";
				mac-address = [ 00 00 00 00 00 00 ];
				netdev-name = "eth0.4";
				phy-handle = <&phy3>;
				phy-mode = "rgmii";
			};
			rtksw_port3: port@3 {
				id = <3>;
				label = "port3";
				mac-address = [ 00 00 00 00 00 00 ];
				netdev-name = "eth0.5";
				phy-handle = <&phy4>;
				phy-mode = "rgmii";
			};
			rtksw_port7: port@7 {
				id = <7>;
				label = "port7";
				mac-address = [ 00 00 00 00 00 00 ];
				netdev-name = "nas0";
			};
		};
	};

	ca_peri{
		compatible = "cortina,ca-peri";
		reg = <0x0 0xf4329018 0x0 0x460>,
		      <0x0 0xf4320000 0x0 0x60>;
		interrupt-parent = <&per_ictl>;
		interrupts = <2>;
		interrupt-names = "TMR1";
	};

#if 0 //# CONFIG_CORTINA_HWSEM is not set ,# CONFIG_CORTINA_IPC2RCPU is not set ,# CONFIG_CORTINA_PELOG is not set

	ipc: ipc@fa0000c8 { /* IPC */
		compatible = "cortina,ipc";
		memory-region = <&ipc_reserved>;
		reg = <0x00000000 0xfa0000c8 0x0 0x48>;				/* TODO - reserved for mailbox register*/
		interrupts = <GIC_SPI IRQ_GLB_IPC_ARM0 IRQ_TYPE_LEVEL_HIGH>;
		pe-ipc-cpuid = <0>;
	};

	sem: sem@fa000000 { /* Hardware Semaphore */
		compatible = "cortina,sem";
		reg = <0x00000000 0xfa000000 0x0 0xc8>;				/* TODO - reserved for semaphore register*/
	};
#endif
#if 0
	pelog@0 {
		compatible = "cortina,pelog"; /* PELOG */
		memory-region = <&pelog_reserved>;
	};

	pectrl{
		compatible = "cortina,pe-ctrl"; /* PE ctrl */
		resets = <&block_rst RCPU0_RESET>, <&block_rst RCPU1_RESET>;
		reset-names = "pe0_reset", "pe1_reset";
	};
#endif

	ldma@90301200 {      /* dma0_channel0  */
		compatible = "cortina,adma";
		reg = <0x00000000 0x90301200 0x0 0x40>,	/* Queue */
			<0x00000000 0x90301600 0x0 0x40>,	/* IRQ MUX */
			<0x00000000 0x90301000 0x0 0x60>,	/* Global */
			<0x00000000 0x903011a0 0x0 0x10>;	/* AXIM2 */

		dma-coherent;
		ldma-channel-id = <0>;
		ldma-irq-mux = <0>;
		interrupts = <GIC_SPI IRQ_GLB_LDMA_0 IRQ_TYPE_LEVEL_HIGH>;
	};
	ldma@90301240 {      /* dma0_channel1  */
		compatible = "cortina,adma";
		reg = <0x00000000 0x90301240 0x0 0x40>,
			<0x00000000 0x90301600 0x0 0x40>,
			<0x00000000 0x90301000 0x0 0x60>,
			<0x00000000 0x903011a0 0x0 0x10>;	/* AXIM2 */

		dma-coherent;
		ldma-channel-id = <1>;
		ldma-irq-mux = <1>;
		interrupts = <GIC_SPI IRQ_GLB_LDMA_1 IRQ_TYPE_LEVEL_HIGH>;
	};

	wdt: wdt@f432901c {
		compatible = "cortina,wdt";
		reg = <0x0 0xf432901c 0x0 0x30>, /* PER_WDT_CTRL */
		      <0x0 0xf43200c0 0x0 0x04>; /*Global configuration settings */
		interrupt-parent = <&per_ictl>;
		interrupts = <IRQ_PER_WDT>;
		clocks = <&apb_pclk>;
		reset-on-timeout;
		delay-reset = <134>; /* Millisecond, maximum is 134ms */
	};


	vsfc: vsfc@0xf4320278 {
		compatible = "realtek,vsfc";
		reg = <0x0 0xf4320278 0x0 0x4c>;
		trig_sel = <0x1>;
		div_sel = <0x0>;

		core_idle_div_en = <0x1>;
		core_min = <0x4>;
		//fss_min = <0x0>;
		//uvlo_min = <0x0>;
		det_recv_sel = <0x1>;
		recv_ctrl1 = <0xAAAA0080>;
		recv_ctrl2 = <0x88880100>;
		recv_ctrl3 = <0x08080140>;

		status = "disabled";
	};

	i2c0: i2c@f4329160 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "cortina,ca77xx-i2c";
		reg = <0x00000000 0xf4329160 0x0 0x28>;
		interrupt-parent = <&per_ictl>;
		interrupts = <IRQ_PER_BIW0>;
		device_type = "i2c";
		clocks = <&apb_pclk>;
		pinctrl-0 = <&i2c0_default>;
		pinctrl-names = "default";
	};

	i2c1: i2c@f4329188 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "cortina,ca77xx-i2c";
		reg = <0x00000000 0xf4329188 0x0 0x28>;
		interrupt-parent = <&per_ictl>;
		interrupts = <IRQ_PER_BIW1>;
		device_type = "i2c";
		clocks = <&apb_pclk>;
	};

        i2s: i2s@f7100000 {
                compatible = "realtek,i2s";
                reg = <0x00000000 0xf7100000 0x0 0x44>,
                      <0x00000000 0xf4320000 0x0 0x200>,
                      <0X00000000 0xf550a000 0x0 0x64>;
                reg-names = "i2s_reg","glb_reg","psds_reg";
                interrupt-parent = <&gic>;
                interrupts =  <GIC_SPI IRQ_GLB_I2S IRQ_TYPE_LEVEL_HIGH>;
        };

	/* explained in Documentation/devicetree/bindings/spi/spi-bus.txt */
	spi0: spi@f43290d8 {
		compatible = "cortina,ca77xx-spi";
		reg = <0x00000000 0xf43290d8 0x0 0x40>;
		interrupt-parent = <&per_ictl>;
		interrupts = <IRQ_PER_SPI>;
		clocks = <&apb_pclk>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	dw_pclk: g3_dw_pclk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <100000000>;
	};
	spi1: spi@f4329600 {
		compatible = "snps,dw-apb-ssi";
		reg = <0x00000000 0xf4329600 0x0 0x60>;
		interrupts = <GIC_SPI IRQ_GLB_SPI0 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&dw_pclk>;
		num-cs = <1>;
		cs-gpios = <0>;
		status = "ok";
		#address-cells = <1>;
		#size-cells = <0>;
	};
	audio: ssp0@f7001b80 {
		compatible = "realtek,rtl_v1-audio", "cortina,ca77xx-audio";
		reg = <0x00000000 0xf7001b80 0x0 0x80>,
		      <0x00000000 0xf7001064 0x0 0x08>,
			  <0x00000000 0xf7001a80 0x0 0x80>,
			  <0x00000000 0xf7001e18 0x0 0x08>,
			  <0x00000000 0xf7001e28 0x0 0x08>,
			  <0x00000000 0xf7001e38 0x0 0x08>;
		reg-names = "ssp", "dma-glb", "dma-ssp", "dma-int-tx",
					"dma-int-rx", "dma-int-ssp";

#if 0
		interrupt-parent = <&dma_ssp_ictl0>;
		interrupts = <IRQ_DMA_SSP_SSP0>,
			     <IRQ_DMA_SSP_TXQ6>,
			     <IRQ_DMA_SSP_RXQ6>;
		interrupt-names = "ssp", "dma-tx", "dma-rx";
#else
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI IRQ_GLB_DMA_SSP_1 IRQ_TYPE_LEVEL_HIGH>,
					 <GIC_SPI IRQ_GLB_DMA_SSP_2 IRQ_TYPE_LEVEL_HIGH>,
					 <GIC_SPI IRQ_GLB_DMA_SSP_3 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "dma-tx", "dma-rx", "ssp";
#endif
	};

	audio_dbg: ssp_dbg {
		compatible = "realtek,rtl_v2-audio_dbg", "cortina,ca77xx-audio_dbg";
	};

	trng: trng@90600200 {
		compatible = "realtek,trng";
		reg = <0x0 0x90600200 0x0 0x68>;
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI IRQ_GLB_TRNG IRQ_TYPE_LEVEL_HIGH>;

		//self-test;
		//lfsr-bypass;
		//corrector-bypass;
	};

	/* USB2 PHY */
	usb_hsphy: usbphy@f432b020 {
		compatible = "realtek,taurus-usb2phy";
		reg = <0x0 0xf432b020 0x0 0x18>;
		reg-names = "u2host_reg";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		resets = <&block_rst USB_RESET>, <&block_ext_rst USB2_PORT1_RESET>;
		reset-names = "usbcore_reset", "usb2port1_reset";

		portmask = <0x3>; /* 0x1: enable port0 | 0x2: enable port1 | 0x3: enable both */

		phy_data_verA = "revA v1.1 (2021.12.13)";
		phy_data_verB = "revB v1.3 (2024.03.06)";
		/*Specify port0 and port1 phy parameter <Port0>, <Port1>*/
		phy_sel = <&phy_param0>, <&phy_param1>;

		phy_param0: phy_param0{
			phy_data_addrA = /bits/ 8
				<0xE0 0xE2 0xE4 0xE7 0xF4 0xE7 0xF4 0xE0 0xE0 0xE0>;
			phy_data_arrayA = /bits/ 8
				<0x1F 0xF9 0x68 0x71 0xDB 0x44 0xBB 0x25 0x21 0x25>;
				/* 0x21->0x25 start calibration */
				/* Address 0xF4(bit#5) specify page number */
			phy_data_addrB = /bits/ 8
				<0xE0 0xE2 0xE4 0xE7 0xF4 0xE7 0xF4 0xE0 0xE0 0xE0>;
			phy_data_arrayB = /bits/ 8
				<0x1F 0xF9 0x3B 0x71 0xDB 0x73 0xBB 0x26 0x22 0x26>;
				/* 0x22->0x26 start calibration */
				/* Address 0xF4(bit#5) specify page number */
		};

		phy_param1: phy_param1{
			phy_data_addrA = /bits/ 8
				<0xE0 0xE2 0xE4 0xE7 0xF4 0xE7 0xF4 0xE0 0xE0 0xE0>;
			phy_data_arrayA = /bits/ 8
				<0x1F 0xF9 0x68 0x71 0xDB 0x44 0xBB 0x25 0x21 0x25>;
				/* 0x21->0x25 start calibration */
				/* Address 0xF4(bit#5) specify page number */
			phy_data_addrB = /bits/ 8
				<0xE0 0xE2 0xE4 0xE7 0xF4 0xE7 0xF4 0xE0 0xE0 0xE0>;
			phy_data_arrayB = /bits/ 8
				<0x1F 0xF9 0x3B 0x71 0xDB 0x53 0xBB 0x26 0x22 0x26>;
				/* 0x22->0x26 start calibration */
				/* Address 0xF4(bit#5) specify page number */
		};
	};

	/* USB3 PHY */
	usb_ssphy: usbphy@f432b000 {
		compatible = "realtek,taurus-usb3phy";
		reg = <0x0 0xf432b000 0x0 0x20>,
			<0 0xf432b04c 0x0 0x10>,
			<0 0xf4337000 0x0 0x1000>,
			<0 0xf4338000 0x0 0x1000>;
		reg-names = "u3host_reg", "u3ext_reg", "s2usbphy_u3port", "s3usbphy_u3port";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		phys = <&s2_usb_phy>, <&s3_usb_phy>;
		phy-names = "s2usb3-phy", "s3usb3-phy";

		phymask = <0x1>; /*  0x1 -- Enable S2/usb3 port
		                     0x2 -- Enable S3/usb3 port
		                  */
		phy_data_verA = "revA v1.1 (2021.10.28)";
		phy_data_addrA = /bits/ 8
		     <0x01 0x04 0x05 0x08 0x09
		      0x0a 0x0b 0x0d 0x0e
		      0x20 0x21 0x22 0x23 0x27
		      0x2b 0x33>;
		phy_data_arrayA = /bits/ 16
		     <0xaccc 0x7000 0x6313 0x30d1 0x424c
		      0xa610 0xb905 0xef2e 0x1000
		      0x705e 0xf8e8 0x0003 0x0b66 0x0241
		      0x0038 0x0001>;
		phy_data_verB = "revB v1.0 (2022.02.24)";
		phy_data_addrB = /bits/ 8
		     <0x01 0x04 0x05 0x08 0x09
		      0x0a 0x0b 0x0d 0x0e
		      0x20 0x21 0x22 0x23 0x27
		      0x2b 0x33
		      0x09 0x09 0x09>;
		phy_data_arrayB = /bits/ 16
		     <0xaccc 0x7000 0x6313 0x30d1 0x424c
		      0xc610 0xa905 0xef2e 0x1000
		      0x705e 0xf8e8 0x0003 0x0b66 0x0241
		      0x0038 0x0001
		      0x424c 0x404c 0x424c>;
	};

	usb3: usb3-xhci@f0200000 {
		compatible = "snps,dwc3";
		dr_mode = "host";
		#address-cells = <2>;
		#size-cells = <2>;
		reg = <0x0 0xf0200000 0x0 0x80000>;
		reg-names = "usb3-xhci-reg";
		ranges;
		/* dma-coherent */
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI IRQ_GLB_USB3_0 IRQ_TYPE_LEVEL_HIGH>;
		usb-phy = <&usb_hsphy>, <&usb_ssphy>;
		snps,parkmode-disable-ss-quirk;
	};

	emmc0: emmc@f4400400 {
		compatible = "Realtek,rtk119x-emmc";
		reg = <0x0 0xf4400400 0x0 0x1b1>,
			<0x0 0xf4320350 0x0 0x18>,
			<0x0 0xf432009c 0x0 0x4>;
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI IRQ_GLB_SD IRQ_TYPE_LEVEL_HIGH>;
		resets = <&block_rst SD_RESET>;
		reset-names = "sd_reset";
		no-sd;
		no-sdio;
		bus-width = <8>;
		max-frequency = <200000000>;
		non-removable;
		cap-mmc-highspeed;
		cap-mmc-hw-reset;
		mmc-ddr-3_3v;
		mmc-ddr-1_8v;
		mmc-hs200-1_8v;
		//mmc-hs400-1_8v;
	};

	ext_gphy: ext_gphy{
		compatible = "realtek,ext-gphy";
		num-cells = <2>;
		/* eth_mapping_phyAddr = <Port#0 PhyAddr#0>, ... ,<Port#n PhyAddr#n>; */
		//port_mapping_phyAddr = <0 0>;
	};
	i2s: i2s@f7100000 {
                compatible = "realtek,i2s";
                reg = <0x00000000 0xf7100000 0x0 0x44>,
	                <0x00000000 0xf4320000 0x0 0x200>,
	                 <0X00000000 0xf550a000 0x0 0x64>;
	        reg-names = "i2s_reg","glb_reg","psds_reg";
                interrupt-parent = <&gic>;
                interrupts = <GIC_SPI IRQ_GLB_I2S IRQ_TYPE_LEVEL_HIGH>;
         };
         rtk_i2s {
                compatible = "realtek, sndcard_rtl8277c_dummy";
                status = "okay";
                realtek,platform =<&test0>;
                test0:test@0 {
                        compatible = "realtek,platform";
                 };

          };

};

#include "rtl8277C-crypto.dtsi"
