		#address-cells = <3>;
		#size-cells = <2>;

		device_type = "pci";
		bus-range = <0x0 0xff>;
		ranges = <0x81000000 0 0          0 0xa0003000 0 0x00010000   /* downstream I/O */
			  /* 0xa0300000 - 0xa03fffff reserved for controller */
			  0x82000000 0 0xa0400000 0 0xa0400000 0 0x0fc00000>; /* non-prefetchable memory */

		id = <0>;
		num-viewport = <1>;
		num-lanes = <1>;
		clocks = <&gate_pcie0_clk>;
		iommus = <&pcie0_atu>;

		interrupt-parent = <&gic>;
