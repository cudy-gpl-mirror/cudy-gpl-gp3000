PWDDIR = $(shell pwd)

ifneq ($(CONFIG_USER_HAPD_VERSION),)
HOSTAPD = hostapd-$(CONFIG_USER_HAPD_VERSION)/hostapd
else
HOSTAPD = hostapd-2.9/hostapd
endif
FILES = files

#RC_LEVEL_LXC = /etc/init.d/rc3
#RC_LEVEL_START = /etc/init.d/rc35

LIBNLDIR = $(TMPFSDIR)
export PKG_CONFIG_PATH = $(LIBNLDIR)/lib/pkgconfig

CFLAGS += -Wno-error=implicit-function-declaration
CFLAGS += -I$(ROOTDIR)/lib/libssl/include

ifeq ("$(CROSS_HOST)", "")
CROSS_HOST = $(ARCH)-linux
CROSS_TARGET = $(ARCH)-linux
endif

ifeq ($(CONFIG_LIB_CAP), y)
CFLAGS += -I$(ROOTDIR)/user/libcap/libcap/include
LDFLAGS += -L$(ROOTDIR)/user/libcap/libcap/ -lcap 
endif

.PHONY: all hostapd

all: hostapd

hostapd:
	@echo -n "Building $(HOSTAPD) ......"
	if [ ! -f $(HOSTAPD)/.config ]; then \
		cp $(FILES)/defconfig $(HOSTAPD)/.config; \
		echo "CFLAGS += -I$(LIBNLDIR)/include/libnl3" >> $(HOSTAPD)/.config; \
		echo "LIBS += -L$(LIBNLDIR)/lib" >> $(HOSTAPD)/.config; \
	fi
	$(MAKE) -C $(HOSTAPD)

romfs:
	@echo "Install HOSTAPD ......."
	$(ROMFSINST) $(HOSTAPD)/hostapd /bin/hostapd
	$(ROMFSINST) $(HOSTAPD)/hostapd_cli /bin/hostapd_cli
	# config file will be generated by "boa/src/LINUX/subr_fw.c"
	#$(ROMFSINST) $(FILES)/wired.conf.eth0.2 /etc/wired.conf.eth0.2
	@cp -a $(FILES)/conf/. $(ROMFSDIR)/etc/conf
	#$(ROMFSINST) $(FILES)/hostapd_wps.sh /etc/hostapd_wps.sh
	#$(ROMFSINST) $(FILES)/hostapd_general_event.sh /etc/hostapd_general_event.sh
	for script in $(shell cd $(FILES); ls *.sh) ; do \
		$(ROMFSINST) $(FILES)/$$script /etc/$$script; \
	done

rcX:

clean:
	$(MAKE) -C $(HOSTAPD) clean

distclean:
	$(MAKE) -C $(HOSTAPD) clean
	rm $(HOSTAPD)/.config

