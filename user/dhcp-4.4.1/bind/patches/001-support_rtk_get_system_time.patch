+isc_result_t rtk_get_system_time(struct timeval *dst_t)
+{
+	struct timespec system_time;
+
+	clock_gettime(CLOCK_MONOTONIC, &system_time);
+	if (dst_t == NULL)
+		return system_time.tv_sec;
+
+	dst_t->tv_sec = system_time.tv_sec;
+	dst_t->tv_usec = system_time.tv_nsec / 1000; //nsec become usec
+	return system_time.tv_sec;
+}
+#endif
 
