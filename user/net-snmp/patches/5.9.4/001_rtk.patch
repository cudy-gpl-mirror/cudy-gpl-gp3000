diff -urN net-snmp-5.9.4.old/agent/mibgroup/rtk/adsl2.c net-snmp-5.9.4/agent/mibgroup/rtk/adsl2.c
--- net-snmp-5.9.4.old/agent/mibgroup/rtk/adsl2.c	1970-01-01 08:00:00.000000000 +0800
+++ net-snmp-5.9.4/agent/mibgroup/rtk/adsl2.c	2024-05-22 20:15:41.719221079 +0800
@@ -0,0 +1,284 @@
+/*
+ *  Template MIB group implementation - adsl2.c
+ *
+ */
+
+/*
+ * include important headers 
+ */
+#include <net-snmp/net-snmp-config.h>
+#if HAVE_STDLIB_H
+#include <stdlib.h>
+#endif
+#if HAVE_STRING_H
+#include <string.h>
+#else
+#include <strings.h>
+#endif
+
+#include <net-snmp/net-snmp-includes.h>
+#include <net-snmp/agent/net-snmp-agent-includes.h>
+
+/*
+ * header_generic() comes from here 
+ */
+#include "util_funcs/header_generic.h"
+
+#include <linux/autoconf.h>
+#include <rtk/adsl_drv.h>
+#include <rtk/adslif.h>
+#include <rtk/utility.h>
+
+
+/*
+ * include our .h file 
+ */
+#include "adsl2.h"
+
+struct adsl2_mib {
+	unsigned int adslAturPerfStatSesL;	   // adsl2_variables_oid.19.1.1
+	unsigned int adslAturPerfStatUasL;	   // adsl2_variables_oid.19.1.2
+	unsigned int adslAturPerfCurr15MinSesL;// adsl2_variables_oid.19.1.3
+	unsigned int adslAturPerfCurr1DaySesL; // adsl2_variables_oid.19.1.5	   
+	unsigned int adslConfProfileLineType;  // adsl2_variables_oid.20.1.1
+};
+
+static struct adsl2_mib adsl2Db;
+
+
+   /*********************
+	 *
+	 *  Initialisation & common implementation functions
+	 *
+	 *********************/
+
+    /*
+     * This array structure defines a representation of the
+     *  MIB being implemented.
+     *
+     * The type of the array is 'struct variableN', where N is
+     *  large enough to contain the longest OID sub-component
+     *  being loaded.  This will normally be the maximum value
+     *  of the fifth field in each line. 
+     */
+struct variable3 adsl2_variables[] = {
+    {ADSLPERFSTATSESL, ASN_INTEGER, NETSNMP_OLDAPI_RONLY,
+     var_adsl2, 3, {19, 1, 1}},
+    {ADSLPERFSTATUASL, ASN_INTEGER, NETSNMP_OLDAPI_RONLY,
+     var_adsl2, 3, {19, 1, 2}},
+    {ADSLPERFCURR15MINSESL, ASN_INTEGER, NETSNMP_OLDAPI_RONLY,
+     var_adsl2, 3, {19, 1, 3}},
+    {ADSLPERFCURR1DAYSESL, ASN_INTEGER, NETSNMP_OLDAPI_RONLY,
+     var_adsl2, 3, {19, 1, 5}},
+    {ADSLCONFLINETYPE, ASN_INTEGER, NETSNMP_OLDAPI_RONLY,
+     var_adsl2, 3, {20, 1, 1}}    
+};
+
+    /*
+     * This array defines the OID of the top of the mib tree that we're
+     *  registering underneath.
+     * Note that this needs to be the correct size for the OID being 
+     *  registered, so that the length of the OID can be calculated.
+     *  The format given here is the simplest way to achieve this.
+     */
+oid   adsl2_variables_oid[] = { 1, 3, 6, 1, 2, 1, 10, 94, 3, 1 };
+
+
+int adsl2_mib_get();
+
+    /*
+     * This function is called at the time the agent starts up
+     *  to do any initializations that might be required.
+     *
+     * In theory it is optional and can be omitted if no
+     *  initialization is needed.  In practise, every module
+     *  will need to register itself (or the objects being
+     *  implemented will not appear in the MIB tree), and this
+     *  registration is typically done here.
+     *
+     * If this function is added or removed, you must re-run
+     *  the configure script, to detect this change.
+     */
+void
+init_adsl2(void)
+{
+    /*
+     * Register ourselves with the agent to handle our mib tree.
+     * The arguments are:
+     *    descr:   A short description of the mib group being loaded.
+     *    var:     The variable structure to load.
+     *                  (the name of the variable structure defined above)
+     *    vartype: The type of this variable structure
+     *    theoid:  The OID pointer this MIB is being registered underneath.
+     */
+    REGISTER_MIB("adsl2", adsl2_variables, variable3,
+                 adsl2_variables_oid);
+}
+
+u_char         *
+var_adsl2(struct variable *vp,
+            oid * name,
+            size_t * length,
+            int exact, size_t * var_len, WriteMethod ** write_method)
+{
+    /*
+     *  The result returned from this function needs to be a pointer to
+     *    static data (so that it can be accessed from outside).
+     *  Define suitable variables for any type of data we may return.
+     */
+	struct adsl2_mib *mib;
+	static unsigned int value;
+	
+    /*
+     * Before returning an answer, we need to check that the request
+     *  refers to a valid instance of this object.  The utility routine
+     *  'header_generic' can be used to do this for scalar objects.
+     *
+     * This routine 'header_simple_table' does the same thing for "simple"
+     *  tables. (See the AGENT.txt file for the definition of a simple table).
+     *
+     * Both these utility routines also set up default values for the
+     *  return arguments (assuming the check succeeded).
+     * The name and length are set suitably for the current object,
+     *  var_len assumes that the result is an integer of some form,
+     *  and write_method assumes that the object cannot be set.
+     *
+     * If these assumptions are correct, this callback routine simply
+     * needs to return a pointer to the appropriate value (using 'long_ret').
+     * Otherwise, 'var_len' and/or 'write_method' should be set suitably.
+     */
+    DEBUGMSGTL(("adsl2", "var_adsl2 entered\n"));
+    if (header_generic(vp, name, length, exact, var_len, write_method) ==
+        MATCH_FAILED)
+        return NULL;
+
+
+    /*
+     * Many object will need to obtain data from the operating system in
+     *  order to return the appropriate value.  Typically, this is done
+     *  here - immediately following the 'header' call, and before the
+     *  switch statement. This is particularly appropriate if a single 
+     *  interface call can return data for all the objects supported. 
+     */	
+	adsl2_mib_get();
+	mib = &adsl2Db;
+	
+    /*
+     * Now use the magic number from the variable pointer 'vp' to
+     *  select the particular object being queried.
+     * In each case, one of the static objects is set up with the
+     *  appropriate information, and returned mapped to a 'u_char *'
+     */	
+    switch (vp->magic) {
+    case ADSLPERFSTATSESL:
+        value = mib->adslAturPerfStatSesL;
+		*var_len = sizeof(int);
+		DEBUGMSGTL(("adsl2", "var_adsl2 ADSLPERFSTATSESL[%d]\n",value));
+        return (u_char *) &value;
+
+    case ADSLPERFSTATUASL:      
+        value = mib->adslAturPerfStatUasL;
+		*var_len = sizeof(int);
+		DEBUGMSGTL(("adsl2", "var_adsl2 ADSLPERFSTATUASL[%d]\n",value));
+        return (u_char *) &value;
+
+    case ADSLPERFCURR15MINSESL:       
+		value = mib->adslAturPerfCurr15MinSesL;
+		*var_len = sizeof(int);
+		DEBUGMSGTL(("adsl2", "var_adsl2 ADSLPERFCURR15MINSESL[%d]\n",value));
+		return (u_char *) &value;
+        
+    case ADSLPERFCURR1DAYSESL:
+        value = mib->adslAturPerfCurr1DaySesL;
+		*var_len = sizeof(int);
+		DEBUGMSGTL(("adsl2", "var_adsl2 ADSLPERFCURR1DAYSESL[%d]\n",value));
+		return (u_char *) &value;
+
+    case ADSLCONFLINETYPE:
+       	value = mib->adslConfProfileLineType;
+		*var_len = sizeof(int);
+		DEBUGMSGTL(("adsl2", "var_adsl2 ADSLCONFLINETYPE[%d]\n",value));
+		return (u_char *) &value;
+
+    default:
+        /*
+         *  This will only be triggered if there's a problem with
+         *   the coding of the module.  SNMP requests that reference
+         *   a non-existant OID will be directed elsewhere.
+         *  If this branch is reached, log an error, so that
+         *   the problem can be investigated.
+         */
+        DEBUGMSGTL(("snmpd", "unknown sub-id %d in rtk/adsl2\n",
+                    vp->magic));
+    }
+    /*
+     * If we fall through to here, fail by returning NULL.
+     * This is essentially a continuation of the 'default' case above.
+     */
+    return NULL;
+}
+
+/* adsl2 get function */
+int adsl2_mib_get()
+{
+	struct adsl2_mib *mib = &adsl2Db;	
+
+	memset(mib, 0, sizeof(struct adsl2_mib));
+	
+#if defined(CONFIG_DEV_xDSL)
+	//adslAturPerfDataExtTable 94.3.1.19, adslAturPerfStatSesL(1)
+	{
+		Modem_DSLConfigStatus vStat;
+		if(adsl_drv_get(RLCM_GET_DSL_STAT_TOTAL, (void *)&vStat, TR069_STAT_SIZE)) {			
+			mib->adslAturPerfStatSesL = vStat.SES;						
+		} else {
+			DEBUGMSGTL(("adsl2", "%s %d: adsl_drv_get id[%d] error\n", __func__, __LINE__, RLCM_GET_DSL_STAT_TOTAL));
+		}
+	}
+
+	//adslAturPerfDataExtTable 94.3.1.19, adslAturPerfStatUasL(2)
+	{
+		Modem_MgmtCounter counter; 
+
+		if(adsl_drv_get(RLCM_GET_DS_ERROR_COUNT, (void *)&counter, sizeof(counter))) {			
+			mib->adslAturPerfStatUasL = counter.uas;						
+		} else {	
+			DEBUGMSGTL(("adsl2", "%s %d: adsl_drv_get id[%d] error\n", __func__, __LINE__, RLCM_GET_DS_ERROR_COUNT));			
+		}
+	}
+	
+	//adslAturPerfDataExtTable 94.3.1.19, adslAturPerfCurr15MinSesL(3)
+	{
+		Modem_DSLConfigStatus vStat;
+
+		if(adsl_drv_get(RLCM_GET_DSL_STAT_15MIN, (void *)&vStat, TR069_STAT_SIZE)) {			
+			mib->adslAturPerfCurr15MinSesL = vStat.SES;					
+		} else {	
+			DEBUGMSGTL(("adsl2", "%s %d: adsl_drv_get id[%d] error\n", __func__, __LINE__, RLCM_GET_DSL_STAT_15MIN));
+		}
+	}
+	
+	//adslAturPerfDataExtTable 94.3.1.19, adslAturPerfCurr1DaySesL(5)
+	{
+		Modem_DSLConfigStatus vStat;
+
+		if(adsl_drv_get(RLCM_GET_DSL_STAT_1DAY, (void *)&vStat, TR069_STAT_SIZE)) {			
+			mib->adslAturPerfCurr1DaySesL = vStat.SES;						
+		} else {		
+			DEBUGMSGTL(("adsl2", "%s %d: adsl_drv_get id[%d] error\n", __func__, __LINE__, RLCM_GET_DSL_STAT_1DAY));
+		}
+	}
+	
+	//adslConfProfileExtTable 94.3.1.20, adslConfProfileLineType(1)
+	{
+		int intVal;
+
+		if(adsl_drv_get(RLCM_GET_CHANNEL_MODE, (void *)&intVal, sizeof(int))) {			
+			mib->adslConfProfileLineType = intVal+1;						
+		} else {	
+			DEBUGMSGTL(("adsl2", "%s %d: adsl_drv_get id[%d] error\n", __func__, __LINE__, RLCM_GET_CHANNEL_MODE));
+		}
+	}
+#endif
+	return 0;
+}
