+/* atmVclTable functions */
+netsnmp_variable_list *
+atmVclTable_first_entry(void **loop_context,
+                     void **data_context,
+                     netsnmp_variable_list *index,
+                     netsnmp_iterator_info *data)
+{
+    if (atmVcl_size == 0)
+        return NULL;
+
+    /*
+     * Point to the first entry, and use the
+     * 'next_entry' hook to retrieve this row
+     */
+    *loop_context = 0;
+    return atmVclTable_next_entry( loop_context, data_context, index, data );
+}
+
+netsnmp_variable_list *
+atmVclTable_next_entry( void **loop_context,
+                     void **data_context,
+                     netsnmp_variable_list *index,
+                     netsnmp_iterator_info *data)
+{
+    int i = (int)*loop_context;
+    netsnmp_variable_list *idx;
+
+    if (atmVcl_size <= i)
+        return NULL;
+
+    /*
+     * Set up the indexing for the specified row...
+     */
+    idx = index;
+    snmp_set_var_value(idx, (u_char *)&if_idx, sizeof(if_idx));
+	
+    idx = idx->next_variable;
+    snmp_set_var_value(idx, (u_char *)&atmVclTable[i].atmVclVpi,
+                                sizeof(atmVclTable[i].atmVclVpi));
+
+	idx = idx->next_variable;
+    snmp_set_var_value(idx, (u_char *)&atmVclTable[i].atmVclVci,
+                                sizeof(atmVclTable[i].atmVclVci));
+
+    /*
+     * ... return the data structure for this row,
+     * and update the loop context ready for the next one.
+     */
+    *data_context = (void*)&atmVclTable[i];
+    *loop_context = (void*)++i;
+
+    return index;
+}
