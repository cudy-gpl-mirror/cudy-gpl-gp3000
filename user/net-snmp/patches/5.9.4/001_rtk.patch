+++ net-snmp-5.9.4/agent/mibgroup/rtk/atm.c	2024-05-03 11:25:42.864387600 +0800
@@ -0,0 +1,1195 @@
+/*
+ *  Template MIB group implementation - atm.c
+ *
+ */
+
+/*
+ * include important headers 
+ */
+#include <net-snmp/net-snmp-config.h>
+#if HAVE_STDLIB_H
+#include <stdlib.h>
+#endif
+#if HAVE_STRING_H
+#include <string.h>
+#else
+#include <strings.h>
+#endif
+
+#include <net-snmp/net-snmp-features.h>
+#include <net-snmp/net-snmp-includes.h>
+#include <net-snmp/agent/net-snmp-agent-includes.h>
+
+/*
+ * header_generic() comes from here 
+ */
+
+#include <rtk/adsl_drv.h>
+#include <rtk/adslif.h>
+#include <rtk/utility.h>
+
+/*
+ * include our .h file 
+ */
+#include "atm.h"
+
+#define ATMINTERFACEADMINADDRESS_LEN			41
+#define ATMINTERFACEMYNEIGHBORIFNAME_LEN		256
+#define ATMINTERFACESUBSCRADDRESS_LEN			41
+
+struct atmInterfaceConfTable_mib {
+	unsigned int atmInterfaceMaxVpcs;
+	unsigned int atmInterfaceMaxVccs;
+	unsigned int atmInterfaceConfVpcs;
+	unsigned int atmInterfaceConfVccs;
+	unsigned int atmInterfaceMaxActiveVpiBits;
+	unsigned int atmInterfaceMaxActiveVciBits;
+	unsigned int atmInterfaceIlmiVpi;
+	unsigned int atmInterfaceIlmiVci;
+	unsigned int atmInterfaceAddressType;
+	char atmInterfaceAdminAddress[ATMINTERFACEADMINADDRESS_LEN];
+	char atmInterfaceMyNeighborIpAddress[4];
+	char atmInterfaceMyNeighborIfName[ATMINTERFACEMYNEIGHBORIFNAME_LEN];
+	unsigned int atmInterfaceCurrentMaxVpiBits;
+	unsigned int atmInterfaceCurrentMaxVciBits;
+	char atmInterfaceSubscrAddress[ATMINTERFACESUBSCRADDRESS_LEN];
+};
+
+struct atmTrafficDescrParamTable_mib { /* atmTrafficDescrParamTable: 1.3.6.1.2.1.37.1.5 */
+	unsigned int atmTrafficDescrParamIndex;
+	unsigned int atmTrafficDescrType;
+	unsigned int atmTrafficDescrParam1;
+	unsigned int atmTrafficDescrParam2;
+	unsigned int atmTrafficDescrParam3;
+	unsigned int atmTrafficDescrParam4;
+	unsigned int atmTrafficDescrParam5;
+	unsigned int atmTrafficQoSClass;
+	unsigned int atmTrafficDescrRowStatus;
+	unsigned int atmServiceCategory;
+	unsigned int atmTrafficFrameDiscard;
+};
+
+struct atmVclTable_mib { /* atmVclTable: 1.3.6.1.2.1.37.1.7 */
+	unsigned int atmVclVpi;
+	unsigned int atmVclVci;
+	unsigned int atmVclAdminStatus;
+	unsigned int atmVclOperStatus;
+	unsigned int atmVclLastChange;
+	unsigned int atmVclReceiveTrafficDescrIndex;
+	unsigned int atmVclTransmitTrafficDescrIndex;
+	unsigned int atmVccAalType;
+	unsigned int atmVccAal5CpcsTransmitSduSize;
+	unsigned int atmVccAal5CpcsReceiveSduSize;
+	unsigned int atmVccAal5EncapsType;
+	unsigned int atmVclCrossConnectIdentifier;
+	unsigned int atmVclRowStatus;
+	unsigned int atmVclCastType;
+	unsigned int atmVclConnKind;
+};
+
+struct aal5VccTable_mib { /* atmVclTable: 1.3.6.1.2.1.37.1.12 */
+	unsigned int aal5VccVpi;
+	unsigned int aal5VccVci;
+	unsigned int aal5VccCrcErrors;
+	unsigned int aal5VccSarTimeOuts;
+	unsigned int aal5VccOverSizedSDUs;
+};
+
+#define ATM_STATS_CACHE_TIMEOUT	5
+
+#define ATM_INTERFACE_TABLE_SIZE 1
+#define ATM_TRAFFIC_TABLE_SIZE 1
+#define ATM_VCL_TABLE_SIZE 2
+#define AAL5_VCC_TABLE_SIZE 3
+
+static unsigned int if_idx;
+
+static int atmInterface_size = 0;
+static struct atmInterfaceConfTable_mib * atmInterfaceTable;
+
+static int atmTraffic_size  = 0;
+static struct atmTrafficDescrParamTable_mib * atmTrafficTable;
+
+static int atmVcl_size = 0;
+static struct atmVclTable_mib * atmVclTable;
+
+static struct aal5VccTable_mib * aal5VccTable;
+static int aal5Vcc_size = 0;
+
+
+/*********************
+ *
+ *  Initialisation & common implementation functions
+ *
+ *********************/
+netsnmp_variable_list *
+atmInterfaceTable_first_entry(void **loop_context,
+                     void **data_context,
+                     netsnmp_variable_list *index,
+                     netsnmp_iterator_info *data)
+{
+    if (atmInterface_size == 0)
+        return NULL;
+
+    /*
+     * Point to the first entry, and use the
+     * 'next_entry' hook to retrieve this row
+     */
+    *loop_context = 0;
+    return atmInterfaceTable_next_entry( loop_context, data_context, index, data );
+}
+
+netsnmp_variable_list *
+atmInterfaceTable_next_entry( void **loop_context,
+                     void **data_context,
+                     netsnmp_variable_list *index,
+                     netsnmp_iterator_info *data)
+{
+    int i = (int)*loop_context;
+    netsnmp_variable_list *idx;
+
+    if (atmInterface_size <= i)
+        return NULL;
+
+    /*
+     * Set up the indexing for the specified row...
+     */
+    idx = index;
+    snmp_set_var_value(idx, (u_char *)&if_idx, sizeof(if_idx));
+
+    /*
+     * ... return the data structure for this row,
+     * and update the loop context ready for the next one.
+     */
+    *data_context = (void*)&atmInterfaceTable[i];
+    *loop_context = (void*)++i;
+
+    return index;
+}
+
+void
+atmInterfaceTable_free(netsnmp_cache *cache, void *magic)
+{
+	if (atmInterfaceTable)
+        free(atmInterfaceTable);
+    atmInterfaceTable  = NULL;
+    atmInterface_size  = 0;
+}
+
+int
+atmInterfaceTable_load(netsnmp_cache *cache, void *vmagic)
+{
+	int i;
+	struct atmInterfaceConfTable_mib * ptr;
+	
+	atmInterfaceTable_free(NULL, NULL);
+
+	atmInterface_size = ATM_INTERFACE_TABLE_SIZE;
+	atmInterfaceTable = (struct atmInterfaceConfTable_mib *) calloc(atmInterface_size, sizeof(struct atmInterfaceConfTable_mib));
+	if (atmInterfaceTable == NULL)
+	{
+		atmInterface_size = 0;	
+	}
+	else
+	{
+		for(i = 0; i < atmInterface_size; i++)
+		{
+			ptr = atmInterfaceTable+i;
+			ptr->atmInterfaceMaxVpcs = 4096;
+			ptr->atmInterfaceMaxVccs = 65536;
+			ptr->atmInterfaceConfVpcs = 4096;
+			ptr->atmInterfaceConfVccs = 65536;
+			ptr->atmInterfaceMaxActiveVpiBits = 12;
+			ptr->atmInterfaceMaxActiveVciBits = 16;
+			ptr->atmInterfaceIlmiVpi = 4095;
+			ptr->atmInterfaceIlmiVci = 65535;
+			ptr->atmInterfaceAddressType = 1;
+			strcpy(ptr->atmInterfaceAdminAddress, "ATM IF Admin Addr");
+			ptr->atmInterfaceMyNeighborIpAddress[0] = 0xaa;
+			ptr->atmInterfaceMyNeighborIpAddress[1] = 0xbb;
+			ptr->atmInterfaceMyNeighborIpAddress[2] = 0xcc;
+			ptr->atmInterfaceMyNeighborIpAddress[3] = 0xdd;
+			strcpy(ptr->atmInterfaceMyNeighborIfName, "ATM IF Neighbor Name");
+			ptr->atmInterfaceCurrentMaxVpiBits = 12;
+			ptr->atmInterfaceCurrentMaxVciBits = 16;
+			strcpy(ptr->atmInterfaceSubscrAddress, "ATM IF Subscr Addr");
+		}
+		
+	}
+
+	if (atmInterface_size > 0) {
+        DEBUGMSGTL(("atm", "Loaded atmInterfaceTable success\n"));
+        return 0;
+    }
+    DEBUGMSGTL(("atm", "Failed to load atmInterfaceTable\n"));
+    return -1;
+}
+
+int
+atmInterfaceTable_handler(netsnmp_mib_handler          *handler,
+                 netsnmp_handler_registration *reginfo,
+                 netsnmp_agent_request_info   *reqinfo,
+                 netsnmp_request_info         *requests)
+{
+    netsnmp_request_info  *request;
+    netsnmp_variable_list *requestvb;
+    netsnmp_table_request_info *table_info;
+    struct atmInterfaceConfTable_mib * entry;
+    oid      subid;
+    unsigned int value;
+	char * str;
+	
+    DEBUGMSGTL(("atm", "atmInterfaceTable Handler - mode %s\n",
+                    se_find_label_in_slist("agent_mode", reqinfo->mode)));
+    switch (reqinfo->mode) {
+    case MODE_GET:
+        for (request=requests; request; request=request->next) {
+            requestvb = request->requestvb;
+            DEBUGMSGTL(( "atm", "oid: "));
+            DEBUGMSGOID(("atm", requestvb->name,
+                                           requestvb->name_length));
+            DEBUGMSG((   "atm", "\n"));
+
+            entry = (struct atmInterfaceConfTable_mib *)netsnmp_extract_iterator_context(request);
+            if (!entry)
+                continue;
+            table_info = netsnmp_extract_table_info(request);
+            subid      = table_info->colnum;
+
+            switch (subid) {
+            case ATM_INTERFACE_MAX_VPCS:
+                value = entry->atmInterfaceMaxVpcs;
+	        	snmp_set_var_typed_value(requestvb, ASN_INTEGER,
+                                 (u_char *)&value, sizeof(value));
+                break;
+			case ATM_INTERFACE_MAX_VCCS:
+                value = entry->atmInterfaceMaxVccs;
+	        	snmp_set_var_typed_value(requestvb, ASN_INTEGER,
+                                 (u_char *)&value, sizeof(value));
+                break;
+			case ATM_INTERFACE_CONF_VPCS:
+                value = entry->atmInterfaceConfVpcs;
+	        	snmp_set_var_typed_value(requestvb, ASN_INTEGER,
+                                 (u_char *)&value, sizeof(value));
+                break;
+			case ATM_INTERFACE_CONF_VCCS:
+                value = entry->atmInterfaceConfVccs;
+	        	snmp_set_var_typed_value(requestvb, ASN_INTEGER,
+                                 (u_char *)&value, sizeof(value));
+                break;
+			case ATM_INTERFACE_MAX_ACTIVEVPIBITS:
+                value = entry->atmInterfaceMaxActiveVpiBits;
+	        	snmp_set_var_typed_value(requestvb, ASN_INTEGER,
+                                 (u_char *)&value, sizeof(value));
+                break;
+			case ATM_INTERFACE_MAX_ACTIVEVCIBITS:
+                value = entry->atmInterfaceMaxActiveVciBits;
+	        	snmp_set_var_typed_value(requestvb, ASN_INTEGER,
+                                 (u_char *)&value, sizeof(value));
+                break;
+			case ATM_INTERFACE_ILMI_VPI:
+                value = entry->atmInterfaceIlmiVpi;
+	        	snmp_set_var_typed_value(requestvb, ASN_INTEGER,
+                                 (u_char *)&value, sizeof(value));
+                break;
+			case ATM_INTERFACE_ILMI_VCI:
+                value = entry->atmInterfaceIlmiVci;
+	        	snmp_set_var_typed_value(requestvb, ASN_INTEGER,
+                                 (u_char *)&value, sizeof(value));
+                break;
+			case ATM_INTERFACE_ADDRESS_TYPE:
+                value = entry->atmInterfaceAddressType;
+	        	snmp_set_var_typed_value(requestvb, ASN_INTEGER,
+                                 (u_char *)&value, sizeof(value));
+                break;
+			case ATM_INTERFACE_ADMIN_ADDRESS:
+                str = entry->atmInterfaceAdminAddress;
+	        	snmp_set_var_typed_value(requestvb, ASN_OCTET_STR,
+                                        (const u_char *) str, strlen(str));
+			case ATM_INTERFACE_NEIGHBOR_IPADDRESS:
+                str = entry->atmInterfaceMyNeighborIpAddress;
+	        	snmp_set_var_typed_value(requestvb, ASN_IPADDRESS,
+                                        (const u_char *) str, 4);
+                break;
+			case ATM_INTERFACE_NEIGHBOR_IFNAME:
+                str = entry->atmInterfaceMyNeighborIfName;
+	        	snmp_set_var_typed_value(requestvb, ASN_OCTET_STR,
+                                        (const u_char *) str, strlen(str));
+                break;
+			case ATM_INTERFACE_CURRENT_MAXVPIBITS:
+                value = entry->atmInterfaceCurrentMaxVpiBits;
+	        	snmp_set_var_typed_value(requestvb, ASN_INTEGER,
+                                 (u_char *)&value, sizeof(value));
+                break;
+			case ATM_INTERFACE_CURRENT_MAXVCIBITS:
+                value = entry->atmInterfaceCurrentMaxVciBits;
+	        	snmp_set_var_typed_value(requestvb, ASN_INTEGER,
+                                 (u_char *)&value, sizeof(value));
+                break;
+			case ATM_INTERFACE_SUBSCR_ADDRESS:
+                str = entry->atmInterfaceSubscrAddress;
+	        	snmp_set_var_typed_value(requestvb, ASN_OCTET_STR,
+                                        (const u_char *) str, strlen(str));
+                break;
+	    	}
+		}
+        break;
+
+    default:
+        snmp_log(LOG_WARNING, "atm: Unrecognised mode (%d)\n",
+                               reqinfo->mode);
+        break;
+    }
+
+    return SNMP_ERR_NOERROR;
+}
+
+/** Initialize the atmTrafficTable table by defining its contents and how it's structured */
+void init_atmInterfaceTable(void)
+{
+	const oid		atmInterfaceTable_oid[] =
+			{ 1, 3, 6, 1, 2, 1, 37, 1, 2 };
+	netsnmp_table_registration_info *table_info;
+	netsnmp_handler_registration *my_handler;
+	netsnmp_iterator_info *iinfo;
+	
+	/* create the table registration information structures */
+	table_info = SNMP_MALLOC_TYPEDEF(netsnmp_table_registration_info);
+	iinfo = SNMP_MALLOC_TYPEDEF(netsnmp_iterator_info);
+	
+	my_handler = netsnmp_create_handler_registration("atmInterfaceTable",
+													atmInterfaceTable_handler,
+													atmInterfaceTable_oid,
+													OID_LENGTH(atmInterfaceTable_oid),
+													HANDLER_CAN_RONLY);
+	
+	if (!my_handler || !table_info || !iinfo) {
+		snmp_log(LOG_ERR, "malloc failed in init_atmInterfaceTable");
+		return; /** Serious error. */
+	}
+	
+	/***************************************************
+	 * Setting up the table's definition
+	 */
+	netsnmp_table_helper_add_indexes(table_info, ASN_INTEGER,
+									 /** index:   ifIndex */
+									 0);
+	
+	/** Define the minimum and maximum accessible columns.	This
+		optimizes retrieval. */
+	table_info->min_column = ATM_INTERFACE_MAX_VPCS;
+	table_info->max_column = ATM_INTERFACE_SUBSCR_ADDRESS;
+	
+	/** iterator access routines */
+	iinfo->get_first_data_point = atmInterfaceTable_first_entry;
+	iinfo->get_next_data_point = atmInterfaceTable_next_entry;
+	
+	/** tie the two structures together */
+	iinfo->table_reginfo = table_info;
+	
+	/***************************************************
+	 * registering the table with the master agent
+	 */
+	DEBUGMSGTL(("atm","Registering table atmInterfaceTable as a table iterator\n"));
+	netsnmp_register_table_iterator2(my_handler, iinfo);
+
+	/*
+     * with a local cache
+     */
+    netsnmp_inject_handler(my_handler,
+		    netsnmp_get_cache_handler(ATM_STATS_CACHE_TIMEOUT,
+			   		atmInterfaceTable_load, atmInterfaceTable_free,
+					atmInterfaceTable_oid, OID_LENGTH(atmInterfaceTable_oid)));
+}
+
+/* atmTrafficTable functions */
+netsnmp_variable_list *
+atmTrafficTable_first_entry(void **loop_context,
+                     void **data_context,
+                     netsnmp_variable_list *index,
+                     netsnmp_iterator_info *data)
+{
+    if (atmTraffic_size == 0)
+        return NULL;
+
+    /*
+     * Point to the first entry, and use the
+     * 'next_entry' hook to retrieve this row
+     */
+    *loop_context = 0;
+    return atmTrafficTable_next_entry( loop_context, data_context, index, data );
+}
+
+netsnmp_variable_list *
+atmTrafficTable_next_entry( void **loop_context,
+                     void **data_context,
+                     netsnmp_variable_list *index,
+                     netsnmp_iterator_info *data)
+{
+    int i = (int)*loop_context;
+    netsnmp_variable_list *idx;
+
+    if (atmTraffic_size <= i)
+        return NULL;
+
+    /*
+     * Set up the indexing for the specified row...
+     */
+    idx = index;
+    snmp_set_var_value(idx, (u_char *)&atmTrafficTable[i].atmTrafficDescrParamIndex,
+                                sizeof(atmTrafficTable[i].atmTrafficDescrParamIndex));
+
+    /*
+     * ... return the data structure for this row,
+     * and update the loop context ready for the next one.
+     */
+    *data_context = (void*)&atmTrafficTable[i];
+    *loop_context = (void*)++i;
+
+    return index;
+}
+
+void
+atmTrafficTable_free(netsnmp_cache *cache, void *magic)
+{
+	if (atmTrafficTable)
+        free(atmTrafficTable);
+    atmTrafficTable  = NULL;
+    atmTraffic_size  = 0;
+}
+
+int
+atmTrafficTable_load(netsnmp_cache *cache, void *vmagic)
+{
+	int i;
+	struct atmTrafficDescrParamTable_mib * ptr;
+	
+	atmTrafficTable_free(NULL, NULL);
+
+	atmTraffic_size = ATM_TRAFFIC_TABLE_SIZE;
+	atmTrafficTable = (struct atmTrafficDescrParamTable_mib *) calloc(atmTraffic_size, sizeof(struct atmTrafficDescrParamTable_mib));
+	if (atmTrafficTable == NULL)
+	{
+		atmTraffic_size = 0;	
+	}
+	else
+	{
+		for(i = 0; i < atmTraffic_size; i++)
+		{
+			ptr = atmTrafficTable+i;
+			ptr->atmTrafficDescrParamIndex = 10;
+			ptr->atmTrafficDescrType = 7;
+			ptr->atmTrafficDescrParam1 = 99;
+			ptr->atmTrafficDescrParam2 = 999;
+			ptr->atmTrafficDescrParam3 = 9999;
+			ptr->atmTrafficDescrParam4 = 99999;
+			ptr->atmTrafficDescrParam5 = 999999;
+			ptr->atmTrafficQoSClass = 255;
+			ptr->atmTrafficDescrRowStatus = 1; 
+			ptr->atmServiceCategory = 2;
+			ptr->atmTrafficFrameDiscard = 1;
+		}
+		
+	}
