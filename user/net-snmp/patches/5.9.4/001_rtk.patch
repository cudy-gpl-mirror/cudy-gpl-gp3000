+static int
+handle_updateMibValue(netsnmp_mib_handler *handler,
+                  netsnmp_handler_registration *reginfo,
+                  netsnmp_agent_request_info *reqinfo,
+                  netsnmp_request_info *requests)
+{
+#ifndef NETSNMP_NO_WRITE_SUPPORT
+#define OID_SYS_CONTACT 	4
+#define OID_SYS_NAME 		5
+#define OID_SYS_LOCATION 	6
+
+    if (reqinfo->mode == MODE_SET_ACTION) {		
+		netsnmp_variable_list *var = requests->requestvb;
+		int oid_type;
+		
+		/* e.g. sysContact oid: .1.3.6.1.2.1.1.4.0, 
+           the last value 0 means index (must be 0)
+		   oid value of the last but one is 4 */
+		oid_type = var->name[var->name_length-2];		
+
+		switch(oid_type)
+		{
+		case OID_SYS_CONTACT:			
+			if ( !mib_set(MIB_SNMP_SYS_CONTACT, (void *)var->val.string)) {			
+				printf("mib_set MIB_SNMP_SYS_CONTACT fail[%s]\n", var->val.string);
+			}
+			break;				
+		case OID_SYS_NAME:
+			if ( !mib_set(MIB_SNMP_SYS_NAME, (void *)var->val.string)) {			
+				printf("mib_set MIB_SNMP_SYS_NAME fail[%s]\n", var->val.string);
+			}
+			break;
+		case OID_SYS_LOCATION:
+			if ( !mib_set(MIB_SNMP_SYS_LOCATION, (void *)var->val.string)) {			
+				printf("mib_set MIB_SNMP_SYS_LOCATION fail[%s]\n", var->val.string);
+			}
+			break;
+		}
+    }
+#endif /* NETSNMP_NO_WRITE_SUPPORT */
+    return SNMP_ERR_NOERROR;
+}
+
+static netsnmp_mib_handler*
+netsnmp_update_mibValue(void)
+{
+    netsnmp_mib_handler* hnd =
+        netsnmp_create_handler("updateMib", handle_updateMibValue);
+    if (hnd)
+        hnd->flags |= MIB_HANDLER_AUTO_NEXT;
+    return hnd;
+}
+
