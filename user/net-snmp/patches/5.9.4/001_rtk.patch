+	        	snmp_set_var_typed_value(requestvb, ASN_INTEGER,
+                                 (u_char *)&value, sizeof(value));
+                break;
+	    	}
+		}
+        break;
+
+    default:
+        snmp_log(LOG_WARNING, "atm: Unrecognised mode (%d)\n",
+                               reqinfo->mode);
+        break;
+    }
+
+    return SNMP_ERR_NOERROR;
+}
+
+void init_aal5VccTable(void)
+{
+	const oid aal5VccTable_oid[] =
+			{ 1, 3, 6, 1, 2, 1, 37, 1, 12 };
+	netsnmp_table_registration_info *table_info;
+	netsnmp_handler_registration *my_handler;
+	netsnmp_iterator_info *iinfo;
+	
+	/* create the table registration information structures */
+	table_info = SNMP_MALLOC_TYPEDEF(netsnmp_table_registration_info);
+	iinfo = SNMP_MALLOC_TYPEDEF(netsnmp_iterator_info);
+	
+	my_handler = netsnmp_create_handler_registration("aal5VccTable",
+													aal5VccTable_handler,
+													aal5VccTable_oid,
+													OID_LENGTH(aal5VccTable_oid),
+													HANDLER_CAN_RONLY);
+	
+	if (!my_handler || !table_info || !iinfo) {
+		snmp_log(LOG_ERR, "malloc failed in init_aal5VccTable");
+		return; /** Serious error. */
+	}
+	
+	/***************************************************
+	 * Setting up the table's definition
+	 */
+	netsnmp_table_helper_add_indexes(table_info, ASN_INTEGER, ASN_INTEGER, ASN_INTEGER,
+									 /** index:  ifIndex, aal5VccVpi, aal5VccVci */
+									 0);
+	
+	/** Define the minimum and maximum accessible columns.	This
+		optimizes retrieval. */
+	table_info->min_column = AAL5_VCC_VPI;
+	table_info->max_column = AAL5_VCC_OVERSIZEDSDUS;
+	
+	/** iterator access routines */
+	iinfo->get_first_data_point = aal5VccTable_first_entry;
+	iinfo->get_next_data_point = aal5VccTable_next_entry;
+	
+	/** tie the two structures together */
+	iinfo->table_reginfo = table_info;
+	
+	/***************************************************
+	 * registering the table with the master agent
+	 */
+	DEBUGMSGTL(("atm","Registering table aal5VccTable as a table iterator\n"));
+	netsnmp_register_table_iterator2(my_handler, iinfo);
+
+	/*
+     * with a local cache
+     */
+    netsnmp_inject_handler(my_handler,
+		    netsnmp_get_cache_handler(ATM_STATS_CACHE_TIMEOUT,
+			   		aal5VccTable_load, aal5VccTable_free,
+					aal5VccTable_oid, OID_LENGTH(aal5VccTable_oid)));
+}
+
+
+    /*
+     * This function is called at the time the agent starts up
+     *  to do any initializations that might be required.
+     *
+     * In theory it is optional and can be omitted if no
+     *  initialization is needed.  In practise, every module
+     *  will need to register itself (or the objects being
+     *  implemented will not appear in the MIB tree), and this
+     *  registration is typically done here.
+     *
+     * If this function is added or removed, you must re-run
+     *  the configure script, to detect this change.
+     */
+void
+init_atm(void)
+{
+	if_idx = 1; /* default set to 1 */
+
+	init_atmInterfaceTable();
+	init_atmTrafficTable();
+	init_atmVclTable();
+	init_aal5VccTable();
+}
+
