+/*
+ *  Template MIB group interface - atm.h
+ *
+ */
+
+/*
+ * Don't include ourselves twice 
+ */
+#ifndef _MIBGROUP_ATM_H
+#define _MIBGROUP_ATM_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+
+    /*
+     * Declare our publically-visible functions.
+     * Typically, these will include the initialization and shutdown functions,
+     *  the main request callback routine and any writeable object methods.
+     *
+     * Function prototypes are provided for the callback routine ('FindVarMethod')
+     *  and writeable object methods ('WriteMethod').
+     */
+    void     init_atm(void);
+
+	Netsnmp_Node_Handler     atmInterfaceTable_handler;
+	NetsnmpCacheLoad         atmInterfaceTable_load;
+	NetsnmpCacheFree         atmInterfaceTable_free;
+	Netsnmp_First_Data_Point atmInterfaceTable_first_entry;
+	Netsnmp_Next_Data_Point  atmInterfaceTable_next_entry;
+	
+	Netsnmp_Node_Handler     atmTrafficTable_handler;
+	NetsnmpCacheLoad         atmTrafficTable_load;
+	NetsnmpCacheFree         atmTrafficTable_free;
+	Netsnmp_First_Data_Point atmTrafficTable_first_entry;
+	Netsnmp_Next_Data_Point  atmTrafficTable_next_entry;
+
+	Netsnmp_Node_Handler     atmVclTable_handler;
+	NetsnmpCacheLoad         atmVclTable_load;
+	NetsnmpCacheFree         atmVclTable_free;
+	Netsnmp_First_Data_Point atmVclTable_first_entry;
+	Netsnmp_Next_Data_Point  atmVclTable_next_entry;
+
+	Netsnmp_Node_Handler     aal5VccTable_handler;
+	NetsnmpCacheLoad         aal5VccTable_load;
+	NetsnmpCacheFree         aal5VccTable_free;
+	Netsnmp_First_Data_Point aal5VccTable_first_entry;
+	Netsnmp_Next_Data_Point  aal5VccTable_next_entry;
+
+    /*
+     * Magic number definitions.
+     * These must be unique for each object implemented within a
+     *  single mib module callback routine.
+     *
+     * Typically, these will be the last OID sub-component for
+     *  each entry, or integers incrementing from 1.
+     *  (which may well result in the same values anyway).
+     *
+     * Here, the second and third objects are form a 'sub-table' and
+     *   the magic numbers are chosen to match these OID sub-components.
+     * This is purely for programmer convenience.
+     * All that really matters is that the numbers are unique.
+     */
+#define ATM_INTERFACE_MAX_VPCS				1
+#define ATM_INTERFACE_MAX_VCCS				2
+#define ATM_INTERFACE_CONF_VPCS				3
+#define ATM_INTERFACE_CONF_VCCS				4
+#define ATM_INTERFACE_MAX_ACTIVEVPIBITS		5
+#define ATM_INTERFACE_MAX_ACTIVEVCIBITS		6
+#define ATM_INTERFACE_ILMI_VPI				7
+#define ATM_INTERFACE_ILMI_VCI				8
+#define ATM_INTERFACE_ADDRESS_TYPE			9
+#define ATM_INTERFACE_ADMIN_ADDRESS			10
+#define ATM_INTERFACE_NEIGHBOR_IPADDRESS	11
+#define ATM_INTERFACE_NEIGHBOR_IFNAME		12
+#define ATM_INTERFACE_CURRENT_MAXVPIBITS	13
+#define ATM_INTERFACE_CURRENT_MAXVCIBITS	14
+#define ATM_INTERFACE_SUBSCR_ADDRESS		15
+
+#define	ATM_TRAFFIC_PARAMINDEX		1
+#define	ATM_TRAFFIC_TYPE			2
+#define	ATM_TRAFFIC_PARAM1			3
+#define	ATM_TRAFFIC_PARAM2			4
+#define	ATM_TRAFFIC_PARAM3			5
+#define	ATM_TRAFFIC_PARAM4			6
+#define	ATM_TRAFFIC_PARAM5			7
+#define	ATM_TRAFFIC_QOSCLASS		8
+#define	ATM_TRAFFIC_ROWSTATUS		9
+#define	ATM_TRAFFIC_CATEGORY		10
+#define	ATM_TRAFFIC_FRAMEDISCARD	11
+
+#define	ATM_VCL_VPI						1
+#define	ATM_VCL_VCI						2
+#define	ATM_VCL_ADMINSTATUS				3
+#define	ATM_VCL_OPERSTATUS				4
+#define	ATM_VCL_LASTCHANGE				5
+#define	ATM_VCL_RECEIVETRAFFICINDEX		6
+#define	ATM_VCL_TRANSMITTRAFFICINDEX	7
+#define	ATM_VCC_AALTYPE					8
+#define	ATM_VCC_AAL5CPCS_TRANSMITSIZE	9
+#define	ATM_VCC_AAL5CPCS_RECEIVESIZE	10
+#define	ATM_VCC_AAL5ENCAPSTYPE			11
+#define	ATM_VCL_CROSSCONNECTID			12
+#define	ATM_VCL_ROWSTATUS				13
+#define	ATM_VCL_CASTTYPE				14
+#define	ATM_VCL_CONNKIND				15
+
+#define	AAL5_VCC_VPI				1
+#define	AAL5_VCC_VCI				2
+#define	AAL5_VCC_CRCERRORS			3
+#define	AAL5_VCC_SARTIMEOUTS		4
+#define	AAL5_VCC_OVERSIZEDSDUS		5
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif                          /* _MIBGROUP_EXAMPLE_H */
diff -urN net-snmp-5.9.4.old/agent/mibgroup/rtk/pon.c net-snmp-5.9.4/agent/mibgroup/rtk/pon.c
--- net-snmp-5.9.4.old/agent/mibgroup/rtk/pon.c	1970-01-01 08:00:00.000000000 +0800
+++ net-snmp-5.9.4/agent/mibgroup/rtk/pon.c	2024-05-03 11:25:42.864387600 +0800
@@ -0,0 +1,355 @@
+/*
+ *  Template MIB group implementation - pon.c
+ *
+ */
+
+/*
+ * include important headers 
+ */
+#include <net-snmp/net-snmp-config.h>
+#if HAVE_STDLIB_H
+#include <stdlib.h>
+#endif
+#if HAVE_STRING_H
+#include <string.h>
+#else
+#include <strings.h>
+#endif
+
+#include <net-snmp/net-snmp-includes.h>
+#include <net-snmp/agent/net-snmp-agent-includes.h>
+
+/*
+ * header_generic() comes from here 
+ */
+#include "util_funcs/header_generic.h"
+#include <linux/autoconf.h>
+#include <rtk/utility.h>
+
+/*
+ * include our .h file 
+ */
+#if defined(CONFIG_RTK_L34_ENABLE)
+#include <rtk_rg_liteRomeDriver.h>
+#else
+#include "rtk/ponmac.h"
+#include "rtk/gpon.h"
+#include "rtk/epon.h"
+#include "rtk/stat.h"
+#include "rtk/switch.h"
+#if defined(CONFIG_COMMON_RT_API)
+#include <rtk/rt/rt_stat.h>
+#include <rtk/rt/rt_epon.h>
+#include <rtk/rt/rt_gpon.h>
+#include <rtk/rt/rt_switch.h>
+#endif
+#endif
+#include "pon.h"
+
+#define PON_TRANSCEIVER_LEN		24
+#define PON_STRING_MAX_LEN		40
+
+union pon_mib {
+	char ponTemperature[PON_TRANSCEIVER_LEN];	//pon_variables_oid.1.2.51.1.1.4194312192.63
+	char ponVoltage[PON_TRANSCEIVER_LEN];		//pon_variables_oid.1.2.51.1.2.4194312192.63
+	char ponTxPower[PON_TRANSCEIVER_LEN];		//pon_variables_oid.1.2.51.1.3.4194312192.63
+	char ponRxPower[PON_TRANSCEIVER_LEN];		//pon_variables_oid.1.2.51.1.4.4194312192.63
+	char ponBiasCurrent[PON_TRANSCEIVER_LEN];	//pon_variables_oid.1.2.51.1.5.4194312192.63
+	char ponVendorName[PON_TRANSCEIVER_LEN];	//pon_variables_oid.1.2.51.1.6.4194312192.63
+	char ponPartName[PON_TRANSCEIVER_LEN];		//pon_variables_oid.1.2.51.1.7.4194312192.63
+};
+
+
+/*********************
+ *
+ *  Initialisation & common implementation functions
+ *
+ *********************/
+
+/*
+ * This array structure defines a representation of the
+ *  MIB being implemented.
+ *
+ * The type of the array is 'struct variableN', where N is
+ *  large enough to contain the longest OID sub-component
+ *  being loaded.  This will normally be the maximum value
+ *  of the fifth field in each line. 
+ */
+struct variable7 pon_variables[] = {
+    {PON_TEMPERATURE, ASN_OCTET_STR, NETSNMP_OLDAPI_RONLY,
+     var_ponmac, 7, {1, 2, 51, 1, 1, 4194312192, 63}},
+    
+    {PON_VOLTAGE, ASN_OCTET_STR, NETSNMP_OLDAPI_RONLY,
+     var_ponmac, 7, {1, 2, 51, 1, 2, 4194312192, 63}},
+     
+    {PON_TX_POWER, ASN_OCTET_STR, NETSNMP_OLDAPI_RONLY,
+     var_ponmac, 7, {1, 2, 51, 1, 3, 4194312192, 63}},
+
+	{PON_RX_POWER, ASN_OCTET_STR, NETSNMP_OLDAPI_RONLY,
+     var_ponmac, 7, {1, 2, 51, 1, 4, 4194312192, 63}},
+
+	{PON_BIAS_CURRENT, ASN_OCTET_STR, NETSNMP_OLDAPI_RONLY,
+     var_ponmac, 7, {1, 2, 51, 1, 5, 4194312192, 63}},
+
+	{PON_VENDOR_NAME, ASN_OCTET_STR, NETSNMP_OLDAPI_RONLY,
+     var_ponmac, 7, {1, 2, 51, 1, 6, 4194312192, 63}},
+
+	{PON_PART_NAME, ASN_OCTET_STR, NETSNMP_OLDAPI_RONLY,
+     var_ponmac, 7, {1, 2, 51, 1, 7, 4194312192, 63}}
+};
+
+/*
+ * This array defines the OID of the top of the mib tree that we're
+ *  registering underneath.
+ * Note that this needs to be the correct size for the OID being 
+ *  registered, so that the length of the OID can be calculated.
+ *  The format given here is the simplest way to achieve this.
+ */
+oid   pon_variables_oid[] = { 1, 3, 6, 1, 4, 1, 2011, 6, 128, 1 };
+
+
+int pon_mib_get(unsigned char magic, union pon_mib *pMib);
+
+/*
+ * This function is called at the time the agent starts up
+ *  to do any initializations that might be required.
+ *
+ * In theory it is optional and can be omitted if no
+ *  initialization is needed.  In practise, every module
+ *  will need to register itself (or the objects being
+ *  implemented will not appear in the MIB tree), and this
+ *  registration is typically done here.
+ *
+ * If this function is added or removed, you must re-run
+ *  the configure script, to detect this change.
+ */
+void
+init_pon(void)
+{
+    /*
+     * Register ourselves with the agent to handle our mib tree.
+     * The arguments are:
+     *    descr:   A short description of the mib group being loaded.
+     *    var:     The variable structure to load.
+     *                  (the name of the variable structure defined above)
+     *    vartype: The type of this variable structure
+     *    theoid:  The OID pointer this MIB is being registered underneath.
+     */
+    REGISTER_MIB("pon", pon_variables, variable7,
+                 pon_variables_oid);
+}
+
+u_char         *
+var_ponmac(struct variable *vp,
+            oid * name,
+            size_t * length,
+            int exact, size_t * var_len, WriteMethod ** write_method)
+{
+    /*
+     *  The result returned from this function needs to be a pointer to
+     *    static data (so that it can be accessed from outside).
+     *  Define suitable variables for any type of data we may return.
+     */
+	union pon_mib mib;
+	static char string[PON_STRING_MAX_LEN]; 
+	
+    /*
+     * Before returning an answer, we need to check that the request
+     *  refers to a valid instance of this object.  The utility routine
+     *  'header_generic' can be used to do this for scalar objects.
+     *
+     * This routine 'header_simple_table' does the same thing for "simple"
+     *  tables. (See the AGENT.txt file for the definition of a simple table).
+     *
+     * Both these utility routines also set up default values for the
+     *  return arguments (assuming the check succeeded).
+     * The name and length are set suitably for the current object,
+     *  var_len assumes that the result is an integer of some form,
+     *  and write_method assumes that the object cannot be set.
+     *
+     * If these assumptions are correct, this callback routine simply
+     * needs to return a pointer to the appropriate value (using 'long_ret').
+     * Otherwise, 'var_len' and/or 'write_method' should be set suitably.
+     */
+    DEBUGMSGTL(("pon", "var_ponmac entered\n"));
+    if (header_generic(vp, name, length, exact, var_len, write_method) ==
+        MATCH_FAILED)
+        return NULL;
+
+
+    /*
+     * Many object will need to obtain data from the operating system in
+     *  order to return the appropriate value.  Typically, this is done
+     *  here - immediately following the 'header' call, and before the
+     *  switch statement. This is particularly appropriate if a single 
+     *  interface call can return data for all the objects supported. 
+     */		
+	pon_mib_get(vp->magic, &mib);
+	
+    /*
+     * Now use the magic number from the variable pointer 'vp' to
+     *  select the particular object being queried.
+     * In each case, one of the static objects is set up with the
+     *  appropriate information, and returned mapped to a 'u_char *'
+     */	
+    switch (vp->magic) {
+    case PON_TEMPERATURE:
+        memset(string, 0, sizeof(string));
+        strcpy(string, mib.ponTemperature);
+		*var_len = strlen(string);
+		DEBUGMSGTL(("pon", "var_ponmac PON_TEMPERATURE[%s]\n", string));
+        return (u_char *) string;
+
+    case PON_VOLTAGE: 
+		memset(string, 0, sizeof(string));
+        strcpy(string, mib.ponVoltage);
+		*var_len = strlen(string);
+		DEBUGMSGTL(("pon", "var_ponmac PON_VOLTAGE[%s]\n", string));
+        return (u_char *) string;
+		
+	case PON_TX_POWER: 
+		memset(string, 0, sizeof(string));
+		strcpy(string, mib.ponTxPower);
+		*var_len = strlen(string);
+		DEBUGMSGTL(("pon", "var_ponmac PON_TX_POWER[%s]\n", string));
+		return (u_char *) string;
+	
+	case PON_RX_POWER: 
+		memset(string, 0, sizeof(string));
+		strcpy(string, mib.ponRxPower);
+		*var_len = strlen(string);
+		DEBUGMSGTL(("pon", "var_ponmac PON_RX_POWER[%s]\n", string));
+		return (u_char *) string;
+	
+	case PON_BIAS_CURRENT: 
+		memset(string, 0, sizeof(string));
+		strcpy(string, mib.ponBiasCurrent);
+		*var_len = strlen(string);
+		DEBUGMSGTL(("pon", "var_ponmac PON_BIAS_CURRENT[%s]\n", string));
+		return (u_char *) string;
+	
+	case PON_VENDOR_NAME: 
+		memset(string, 0, sizeof(string));
+		strcpy(string, mib.ponVendorName);
+		*var_len = strlen(string);
+		DEBUGMSGTL(("pon", "var_ponmac PON_VENDOR_NAME[%s]\n", string));
+		return (u_char *) string;
+	
+	case PON_PART_NAME: 
+		memset(string, 0, sizeof(string));
+		strcpy(string, mib.ponPartName);
+		*var_len = strlen(string);
+		DEBUGMSGTL(("pon", "var_ponmac PON_PART_NAME[%s]\n", string));
+		return (u_char *) string;
+	
+    default:
+        /*
+         *  This will only be triggered if there's a problem with
+         *   the coding of the module.  SNMP requests that reference
+         *   a non-existant OID will be directed elsewhere.
+         *  If this branch is reached, log an error, so that
+         *   the problem can be investigated.
+         */
+        DEBUGMSGTL(("pon", "unknown sub-id %d in rtk/pon\n",
+                    vp->magic));
+    }
+    /*
+     * If we fall through to here, fail by returning NULL.
+     * This is essentially a continuation of the 'default' case above.
+     */
+    return NULL;
+}
+
+/* pon get function */
+int pon_mib_get(unsigned char magic, union pon_mib *pMib)
+{
+	rtk_transceiver_data_t transceiver, readableCfg;
+
+	memset(pMib, 0, sizeof(union pon_mib));
+	memset(&transceiver, 0, sizeof(transceiver));
+	memset(&readableCfg, 0, sizeof(readableCfg));
+	
+	switch (magic)
+	{
+		case PON_TEMPERATURE:
+#if defined(CONFIG_RTK_L34_ENABLE)
+			rtk_rg_ponmac_transceiver_get
+				(RTK_TRANSCEIVER_PARA_TYPE_TEMPERATURE, &transceiver);
+#else
+			rtk_ponmac_transceiver_get
+				(RTK_TRANSCEIVER_PARA_TYPE_TEMPERATURE, &transceiver);
+#endif
+			_get_data_by_type(RTK_TRANSCEIVER_PARA_TYPE_TEMPERATURE, &transceiver, &readableCfg);
+			memcpy(pMib->ponTemperature, readableCfg.buf, sizeof(readableCfg.buf));
+			break;
+		case PON_VOLTAGE:
+#if defined(CONFIG_RTK_L34_ENABLE)
+			rtk_rg_ponmac_transceiver_get
+				(RTK_TRANSCEIVER_PARA_TYPE_VOLTAGE, &transceiver);
+#else
+			rtk_ponmac_transceiver_get
+				(RTK_TRANSCEIVER_PARA_TYPE_VOLTAGE, &transceiver);
+#endif
+			_get_data_by_type(RTK_TRANSCEIVER_PARA_TYPE_VOLTAGE, &transceiver, &readableCfg);
+			memcpy(pMib->ponVendorName, readableCfg.buf, sizeof(readableCfg.buf));
+			break;
+		case PON_TX_POWER:
+#if defined(CONFIG_RTK_L34_ENABLE)
+			rtk_rg_ponmac_transceiver_get
+				(RTK_TRANSCEIVER_PARA_TYPE_TX_POWER, &transceiver);
+#else
+			rtk_ponmac_transceiver_get
+				(RTK_TRANSCEIVER_PARA_TYPE_TX_POWER, &transceiver);
+#endif
+			_get_data_by_type(RTK_TRANSCEIVER_PARA_TYPE_TX_POWER, &transceiver, &readableCfg);
+			memcpy(pMib->ponTxPower, readableCfg.buf, sizeof(readableCfg.buf));
+			break;
+		case PON_RX_POWER:
+#if defined(CONFIG_RTK_L34_ENABLE)
+			rtk_rg_ponmac_transceiver_get
+				(RTK_TRANSCEIVER_PARA_TYPE_RX_POWER, &transceiver);
+#else
+			rtk_ponmac_transceiver_get
+				(RTK_TRANSCEIVER_PARA_TYPE_RX_POWER, &transceiver);
+#endif
+			_get_data_by_type(RTK_TRANSCEIVER_PARA_TYPE_RX_POWER, &transceiver, &readableCfg);
+			memcpy(pMib->ponRxPower, readableCfg.buf, sizeof(readableCfg.buf));
+			break;
+		case PON_BIAS_CURRENT:
+#if defined(CONFIG_RTK_L34_ENABLE)
+			rtk_rg_ponmac_transceiver_get
+				(RTK_TRANSCEIVER_PARA_TYPE_BIAS_CURRENT, &transceiver);
+#else
+			rtk_ponmac_transceiver_get
+				(RTK_TRANSCEIVER_PARA_TYPE_BIAS_CURRENT, &transceiver);
+#endif
+			_get_data_by_type(RTK_TRANSCEIVER_PARA_TYPE_BIAS_CURRENT, &transceiver, &readableCfg);
+			memcpy(pMib->ponBiasCurrent, readableCfg.buf, sizeof(readableCfg.buf));
+			break;
+		case PON_VENDOR_NAME:
+#if defined(CONFIG_RTK_L34_ENABLE)
+			rtk_rg_ponmac_transceiver_get
+				(RTK_TRANSCEIVER_PARA_TYPE_VENDOR_NAME, &transceiver);
+#else
+			rtk_ponmac_transceiver_get
+				(RTK_TRANSCEIVER_PARA_TYPE_VENDOR_NAME, &transceiver);
+#endif
+			_get_data_by_type(RTK_TRANSCEIVER_PARA_TYPE_VENDOR_NAME, &transceiver, &readableCfg);
+			memcpy(pMib->ponVendorName, readableCfg.buf, sizeof(readableCfg.buf));
+			break;
+		case PON_PART_NAME:
+#if defined(CONFIG_RTK_L34_ENABLE)
+			rtk_rg_ponmac_transceiver_get
+				(RTK_TRANSCEIVER_PARA_TYPE_VENDOR_PART_NUM, &transceiver);
+#else
+			rtk_ponmac_transceiver_get
+				(RTK_TRANSCEIVER_PARA_TYPE_VENDOR_PART_NUM, &transceiver);
+#endif
+			_get_data_by_type(RTK_TRANSCEIVER_PARA_TYPE_VENDOR_PART_NUM, &transceiver, &readableCfg);
+			memcpy(pMib->ponPartName, readableCfg.buf, sizeof(readableCfg.buf));
+			break;
+	}
+
+	return 0;
+}
+
diff -urN net-snmp-5.9.4.old/agent/mibgroup/rtk/pon.h net-snmp-5.9.4/agent/mibgroup/rtk/pon.h
--- net-snmp-5.9.4.old/agent/mibgroup/rtk/pon.h	1970-01-01 08:00:00.000000000 +0800
+++ net-snmp-5.9.4/agent/mibgroup/rtk/pon.h	2024-05-21 14:48:01.121424142 +0800
@@ -0,0 +1,62 @@
+/*
+ *  Template MIB group interface - pon.h
+ *
+ */
+
+/*
+ * Don't include ourselves twice 
+ */
+#ifndef _MIBGROUP_PON_H
+#define _MIBGROUP_PON_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+    /*
+     * We use 'header_generic' from the util_funcs/header_generic module,
+     *  so make sure this module is included in the agent.
+     */
+config_require(util_funcs/header_generic);
+
+
+    /*
+     * Declare our publically-visible functions.
+     * Typically, these will include the initialization and shutdown functions,
+     *  the main request callback routine and any writeable object methods.
+     *
+     * Function prototypes are provided for the callback routine ('FindVarMethod')
+     *  and writeable object methods ('WriteMethod').
+     */
+   	void     init_pon(void);
+   	FindVarMethod var_ponmac;
+
+    /*
+     * Magic number definitions.
+     * These must be unique for each object implemented within a
+     *  single mib module callback routine.
+     *
+     * Typically, these will be the last OID sub-component for
+     *  each entry, or integers incrementing from 1.
+     *  (which may well result in the same values anyway).
+     *
+     * Here, the second and third objects are form a 'sub-table' and
+     *   the magic numbers are chosen to match these OID sub-components.
+     * This is purely for programmer convenience.
+     * All that really matters is that the numbers are unique.
+     */
+
+#define	PON_TEMPERATURE                 1
+#define PON_VOLTAGE                     2
+#define	PON_TX_POWER                    3
+#define PON_RX_POWER                    4
+#define	PON_BIAS_CURRENT                5
+#define	PON_VENDOR_NAME                 6
+#define	PON_PART_NAME                   7
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif                          /* _MIBGROUP_PON_H */
+
