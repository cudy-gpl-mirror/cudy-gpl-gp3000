+static void adsl_15MinEssTrapHandler(unsigned int clientreg, void *clientarg)
+{
+	struct adsl_mib *mib;
+	unsigned int val;
+	/* adslAturPerfESsThreshtrap NOTIFICATION-TYPE 
+	  * OBJECTS { adslAturPerfCurr15MinESs, adslAturThresh15MinESs }
+	  * 1.3.6.1.2.1.10.94.1.2.2.0.4
+	  */
+	oid   notification_oid[] = { 1, 3, 6, 1, 2, 1, 10, 94, 1, 2, 2, 0, 4};
+    size_t notification_oid_len = OID_LENGTH(notification_oid);
+
+	/*
+     * In the notification, we have to assign our notification OID to
+     * the snmpTrapOID.0 object. Here is it's definition. 
+     */
+    oid     objid_snmptrap[] = { 1, 3, 6, 1, 6, 3, 1, 1, 4, 1, 0 };
+    size_t  objid_snmptrap_len = OID_LENGTH(objid_snmptrap);
+
+	/*
+     * define the OIDs for the varbinds we're going to include
+     *  with the notification -
+     *  adslAturThresh15MinESs  1.3.6.1.2.1.10.94.1.1.15.1.15
+     */
+    oid     adsl_15MinEssTrap_oid[]   = { 1, 3, 6, 1, 2, 1, 10, 94, 1, 1, 15, 1, 15, 0};
+    size_t  adsl_15MinEssTrap_len = OID_LENGTH(adsl_15MinEssTrap_oid);
+
+	netsnmp_variable_list *notification_vars = NULL;
+	
+	adsl_mib_get();
+	mib = &adslDb;
+
+	val = *(int *)clientarg;
+
+	if(mib->adslAturPerfCurr15MinESs >= val)
+	{
+		DEBUGMSGTL(("adsl","adsl_15MinEssTrapHandler sending the trap [%d]\n", mib->adslAturPerfCurr15MinESs));
+
+    	snmp_varlist_add_variable(&notification_vars,
+                              objid_snmptrap, objid_snmptrap_len,
+                              ASN_OBJECT_ID,(u_char *) notification_oid,
+                              notification_oid_len * sizeof(oid));
+		/*
+    	 * add in the additional objects defined as part of the trap
+     	 */
+    	snmp_varlist_add_variable(&notification_vars,
+                               adsl_15MinEssTrap_oid, adsl_15MinEssTrap_len,
+                               ASN_INTEGER, (u_char *)&mib->adslAturPerfCurr15MinESs,
+                               sizeof(unsigned int));
+		DEBUGMSGTL(("adsl", "sending trap\n"));
+	    send_v2trap(notification_vars);
+
+	    /*
+	     * free the created notification variable list 
+	     */
+	    DEBUGMSGTL(("adsl", "cleaning up trap\n"));
+	    snmp_free_varbind(notification_vars);
+	}
+}
+
+int adsl_15MinEssTrap(int action, u_char * var_val,
+                  u_char var_val_type, size_t var_val_len,
+                  u_char * statP, oid * name, size_t name_len)
+{
+    static unsigned int intval;
+	
+    DEBUGMSGTL(("adsl", "adsl_15MinEssTrap entered: action=%d\n",
+                action));
+    switch (action) {
+    case RESERVE1:
+        if (var_val_type != ASN_INTEGER) {
+            DEBUGMSGTL(("adsl", "%x not integer type", var_val_type));
+            return SNMP_ERR_WRONGTYPE;
+        }
+        if (var_val_len > sizeof(unsigned int)) {
+            DEBUGMSGTL(("adsl", "wrong length %" NETSNMP_PRIz "u",
+                        var_val_len));
+            return SNMP_ERR_WRONGLENGTH;
+        }
+
+        intval = *((unsigned int *) var_val);
+        if (intval > ADSL_ATUR_THRESH_15MINESS_MAX) {
+            DEBUGMSGTL(("adsl", "wrong value %lx", intval));
+            return SNMP_ERR_WRONGVALUE;
+        }
+
+        break;
+
+    case RESERVE2:
+        /*
+         * No resources are required.... 
+         */
+        break;
+
+    case FREE:
+        /*
+         * ... so no resources need be freed 
+         */
+        break;
+
+    case ACTION:
+		{
+			Modem_LossData vLd;
+
+			vLd.ESs_NE = intval;
+#if defined(CONFIG_DEV_xDSL)
+			adsl_drv_get(RLCM_SET_TRAP_THRESHOLD, (void *)&vLd, RLCM_GET_LOSS_DATA_SIZE);
+#endif
+	        break;
+    	}
+    case UNDO:
+        /*
+         * We haven't done anything yet,
+         * so there's nothing to undo 
+         */
+        break;
+
+    case COMMIT:
+        /*
+         *  Everything else worked, so it's now safe
+         *   to trigger the trap.
+         *  Note that this is *only* acceptable since
+         *   the trap sending routines are "failsafe".
+         *  (In fact, they can fail, but they return no
+         *   indication of this, which is the next best thing!)
+         */
+        if(intval == 0 && adslAturThresh > 0 && alarmRegId > 0)
+		{
+			DEBUGMSGTL(("adsl", "adsl_15MinEssTrap unregister alarm\n"));
+			snmp_alarm_unregister(alarmRegId);
+			adslAturThresh = 0;
+		}
+		else
+		{
+			DEBUGMSGTL(("adsl", "adsl_15MinEssTrap register alarm\n"));
+			adslAturThresh = intval;
+			alarmRegId = snmp_alarm_register(60, SA_REPEAT,  adsl_15MinEssTrapHandler,  &adslAturThresh);    
+		}
+        break;
+    }
+    return SNMP_ERR_NOERROR;
+}
