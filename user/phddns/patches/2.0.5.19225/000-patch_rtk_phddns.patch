 	}
 	if (sig == SIGTERM)
 	{
 		printf ("signal = SIGTERM\n");
 		phddns_stop(&global);
+		if(parameter.pidfile) unlink(parameter.pidfile);
+		exit(0);
 	}
 	signal (sig, my_handleSIG);
 }
