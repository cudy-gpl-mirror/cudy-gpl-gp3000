 static void myOnDomainRegistered(char *domain)
 {
+	memset(reg_domain, 0, sizeof(reg_domain));
+	strncpy(reg_domain, domain, sizeof(reg_domain)-1);
 	printf("myOnDomainRegistered %s\n", domain);
