 }
+
+void
+get_phase(void *opaque, int arg)
+{
+	char cmd[512] = {0};
+
+    info("ppp%d : phasechange to %d", req_unit, arg);
+	snprintf(cmd, sizeof(cmd), "sysconf send_unix_sock_message /var/run/systemd.usock do_update_ppp_phase %d %d", req_unit, arg);
+	system(cmd);
+}
