#! /bin/sh
#############################################################################
#
#	Generate the vendor/product menu entries for the top level config
#
#############################################################################

fix_name()
{
	echo $1 | tr '[\-\.\/\+a-z]' '[____A-Z]'
}
find_str()
{
        if grep "$1" .config > /dev/null
        then
                return 0
        fi
        return 1

}

#############################################################################
#
# the header of the config
#

cat <<!EOF
mainmenu_name 'uClinux Configuration'
mainmenu_option next_comment
comment 'Target Platform Selection'
comment 'Choose a Vendor/Product combination.'
!EOF

#############################################################################
#
# Figure out the vendor/products dynamically, allows people to add there
# own without messin with the config.in file
#
if find_str "CONFIG_DEFAULTS_KERNEL_4_14=y"
then
PRECONF_DIR=conf414
PRECONFIG=`find ./ -maxdepth 1 -name "preconfig*_*_loaded" | xargs basename |  sed 's/preconfig414_//g' | sed 's/_loaded//g'`
fi
if find_str "CONFIG_DEFAULTS_KERNEL_4_4=y"
then
PRECONF_DIR=conf44
PRECONFIG=`find ./ -maxdepth 1 -name "preconfig*_*_loaded" | xargs basename |  sed 's/preconfig44_//g' | sed 's/_loaded//g'`
fi
if find_str "CONFIG_DEFAULTS_KERNEL_5_10=y"
then
PRECONF_DIR=conf510
PRECONFIG=`find ./ -maxdepth 1 -name "preconfig*_*_loaded" | xargs basename |  sed 's/preconfig510_//g' | sed 's/_loaded//g'`
fi

if find_str "CONFIG_DEFAULTS_KERNEL_3_18=y"
then
PRECONF_DIR=conf318
PRECONFIG=`find ./ -maxdepth 1 -name "preconfig*_*_loaded" | xargs basename |  sed 's/preconfig318_//g' | sed 's/_loaded//g'`
fi

echo -n "choice 'Vendor/Product' \""

CONFIG_ARCH_FILE=config.arch
if ! find_str "asdk"
then
        if find_str "CONFIG_DEFAULTS_REALTEK_LUNA=y"
        then
                CONFIG_ARCH_FILE=config.arch.mips
	elif find_str "CONFIG_DEFAULTS_REALTEK_LUNA_XDSL=y"
	then
		CONFIG_ARCH_FILE=config.arch.mips
	fi
fi

find vendors/*/*/$CONFIG_ARCH_FILE -print | sed -e 's?/? ?g' | \
		sort | while read t1 v p t2
do
	[ "$v" = "config" ] && continue	
	if [ -d "vendors/${v}/${p}/${PRECONF_DIR}/${PRECONFIG}" ]; then 
	if [ -f "vendors/$v/$p/config.languages" ]
	then
		for i in `cat "vendors/$v/$p/config.languages"`
		do
			echo "${v}/${p}($i) CONFIG_DEFAULTS_`fix_name ${v}`_`fix_name ${p}`_`fix_name ${i}` \\"
		done
	else
		echo "${v}/${p} CONFIG_DEFAULTS_`fix_name ${v}`_`fix_name ${p}` \\"
	fi
	fi
done

echo "\" "

#############################################################################
#
# Which kernel do they want,  if only one then just set it,  I don't
# expect an explosion of kernels just yet ;-)
#

KERNELS="`ls -d linux-* 2>/dev/null`"
NKERNELS="`echo ${KERNELS} | wc -w`"
if [ ${NKERNELS} -gt 1 ]; then
	echo -n "choice 'Kernel Version' \""
	for i in ${KERNELS}; do
		VER=${i##linux-}
		CFG="CONFIG_DEFAULTS_KERNEL_`echo ${VER%%.x}|sed -e 's/\./_/'`"
		DEF="linux-${VER}"
		echo "${DEF} ${CFG} \\"
	done
	echo "\" $DEF"
elif [ ${NKERNELS} -eq 1 ]; then
	VER=${KERNELS##linux-}
	CFG="CONFIG_DEFAULTS_KERNEL_`echo ${VER%%.x}|sed -e 's/\./_/'`"
	echo "comment 'Kernel is linux-${VER}'"
	echo "define_bool ${CFG} y"
else
	echo "ERROR: you have no kernels available in this directory." >&2
	exit 1
fi

cat <<!EOF
if [ "\$CONFIG_DEFAULTS_KERNEL_5_10" = "y" ]; then
	choice 'LINUX Kernel 5.10 Version'	"5.10.x         CONFIG_KERNEL_5_10_x
						"5.10.x
fi
if [ "\$CONFIG_DEFAULTS_KERNEL_4_14" = "y" ]; then
	choice 'LINUX Kernel 4.14 Version'	"4.14.x         CONFIG_KERNEL_4_14_x
						"4.14.x
fi
if [ "\$CONFIG_DEFAULTS_KERNEL_4_4" = "y" ]; then
	choice 'LINUX Kernel 4.4 Version'	"4.4.x         CONFIG_KERNEL_4_4_x
						"4.4.x
fi
if [ "\$CONFIG_DEFAULTS_KERNEL_3_18" = "y" ]; then
	choice 'LINUX Kernel 3.18 Version'	"3.18.x         CONFIG_KERNEL_3_18_x
						"3.18.x
fi
	bool 'Use RSDK-Wrapper Toolchain'	CONFIG_USE_RSDK_WRAPPER
	if [ "\$CONFIG_LUNA_DUAL_LINUX" = "y" ]; then
		string 'RSDK Toolchain Path for Master' CONFIG_RSDK_DIR_MASTER
		string 'RSDK Toolchain Path for Slave'  CONFIG_RSDK_DIR_SLAVE
	else
		string 'RSDK Toolchain Path'	CONFIG_RSDK_DIR
	fi
!EOF
#############################################################################
#
# the rest of the config
#

cat <<!EOF
bool 'Customize Kernel Settings' CONFIG_DEFAULTS_KERNEL
!EOF
[ -d modules ] &&
	echo "bool 'Customize Module Settings' CONFIG_DEFAULTS_MODULES"
cat <<!EOF
bool 'Customize Vendor/User Settings' CONFIG_DEFAULTS_VENDOR
bool 'Config Busybox Settings'     CONFIG_MCONF_BZBOX
if [ "\$CONFIG_LUNA_DUAL_LINUX" = "y" ]; then
	bool 'Customize Slave Kernel Settings'        CONFIG_DEFAULTS_SLAVE_KERNEL
	bool 'Customize Slave Vendor/User Settings'   CONFIG_DEFAULTS_SLAVE_VENDOR
	bool 'Customize Slave Busybox Setting' CONFIG_MCONF_SLAVE_BZBOX
fi
bool 'Tiny Image'                CONFIG_IMAGE_TINY
bool 'Use AARCH32 LINUX Image.(For ARMv8)'                CONFIG_32BIT_IMAGE
if [ "\$CONFIG_32BIT_IMAGE" = "y" ]; then
	bool 'Use AARCH64 Bootloader.'         CONFIG_64BIT_BOOTLOADER
fi
bool 'VoIP IPC DSP Architecture' CONFIG_VOIP_IPC_DSP_ARCHITECTURE

bool 'Wifi Offload PE Architecture' CONFIG_WFO_PE_ARCHITECTURE

bool 'Luna trunk only'           CONFIG_LUNA

if [ "\$CONFIG_LUNA_DUAL_LINUX" != "y" ]; then
bool 'Luna memory auto distribution' CONFIG_LUNA_MEMORY_AUTO_DETECTION
else
define_bool CONFIG_LUNA_MEMORY_AUTO_DETECTION n
fi

if [ "\$CONFIG_LUNA_MEMORY_AUTO_DETECTION" = "y" ] && [ \( "\$CONFIG_VOIP_IPC_DSP_ARCHITECTURE" = "y" -o "\$CONFIG_WFO_PE_ARCHITECTURE" = "y" \) ]; then
       #hex  "RTL8686 CPU MEM Size" CONFIG_RTL8686_CPU_MEM_SIZE 0x03800000
	hex  "RTL8686 IPC MEM Size" CONFIG_RTL8686_IPC_MEM_SIZE 0x00100000
	hex  "RTL8686 DSP MEM Size" CONFIG_RTL8686_DSP_MEM_SIZE 0x00700000
fi

bool 'Multiple DTB in uImage' CONFIG_UIMAGE_MULTI_DTB

bool 'mksquashfs block size option' CONFIG_MKSQUASHFS_BLOCK_SIZE_OPTION
if [ "\$CONFIG_MKSQUASHFS_BLOCK_SIZE_OPTION" = "y" ]; then
	comment 'Block size range from 256K to 1024K (262144~1048576)'
	int "mksquashfs block size" CONFIG_MKSQUASHFS_BLOCK_SIZE 1048576
fi


mainmenu_option next_comment
comment "Bootloader Setting"
string 'U-BOOT Version' CONFIG_UBOOT_VER ''
comment "Bootloader 1 Setting"
string 'BL-1: U-BOOT Environment File' CONFIG_UBOOT_ENVFILE ''
string 'BL-1: U-BOOT Config File' CONFIG_UBOOT_CONF  ''
string 'BL-1: ARM TRUSTED FIRMWARE' CONFIG_ARM_TRUSTED_FIRMWARE ''
comment "Bootloader 2 Setting"
bool 'Build Second Bootloader' CONFIG_SDK_2TH_BL_GEN
if [ "\$CONFIG_SDK_2TH_BL_GEN" = "y" ]; then 
string 'BL-2: U-BOOT Environment File' CONFIG_UBOOT2_ENVFILE ''
string 'BL-2: U-BOOT Config File' CONFIG_UBOOT2_CONF  ''
string 'BL-2: ARM TRUSTED FIRMWARE' CONFIG_ARM_TRUSTED_FIRMWARE2 ''
fi

comment "----- U-Boot Secure Boot Options ------"
if [ "\$CONFIG_UBOOT_VER" = "u-boot-2018.11" ]; then
	bool 'U-Boot Verified Boot' CONFIG_UBOOT_SIGNATURE_FIT
fi
if [ "\$CONFIG_UBOOT_VER" = "u-boot-2020.01" ]; then
	bool 'U-Boot Verified Boot' CONFIG_UBOOT_SIGNATURE_FIT
	bool 'U-Boot Encryption' CONFIG_UBOOT_ENCRYPT
fi
if [ "\$CONFIG_UBOOT_VER" = "u-boot-2022.10" ]; then
	bool 'U-Boot Encryption' CONFIG_UBOOT_ENCRYPT
	bool 'U-Boot Verified Boot' CONFIG_UBOOT_SIGNATURE_FIT
	if [ "\$CONFIG_UBOOT_SIGNATURE_FIT" = "y" ] && [ "\$CONFIG_KERNEL_5_10_x" = "y" ]; then
		bool ' with PSS Padding' CONFIG_UBOOT_SIGN_PSS
		if [ "\$CONFIG_UBOOT_SIGN_PSS" = "y" ]; then
			bool ' with Encryption' CONFIG_UBOOT_CIPHER
		fi
	fi
fi
comment "----- BootLoader Size Selection ------"
choice 'Bootloader Size' \
"default CONFIG_BL_SIZE_DEFAULT \
0x00440000 CONFIG_BL_SIZE_00440000 \
0x00340000 CONFIG_BL_SIZE_00340000 \
0x002C0000 CONFIG_BL_SIZE_002C0000 \
0x00240000 CONFIG_BL_SIZE_00240000 \
" default
endmenu

bool 'Hardware version check'        CONFIG_HWVER_CHECK
if [ "\$CONFIG_HWVER_CHECK" = "y" ]; then
string 'User define Hardware Version'        CONFIG_HW_HWVER 'skip'
fi

mainmenu_option next_comment
comment "SDK Image UBIARGS Setting for 2K/4K Flash Page Size"
bool 'Flash Page Size:2K' CONFIG_LUNA_SDK_IMG_PG_2K
if [ "\$CONFIG_LUNA_SDK_IMG_PG_2K" = "y" ]; then
	string 'UBINIZE_ARGS for 2K Page' CONFIG_LUNA_SDK_IMG_PG_UBI_2K '-m 2048 -p 128KiB -s 2048'
fi
bool 'Flash Page Size:4K' CONFIG_LUNA_SDK_IMG_PG_4K
if [ "\$CONFIG_LUNA_SDK_IMG_PG_4K" = "y" ]; then
	string 'UBINIZE_ARGS for 4K Page' CONFIG_LUNA_SDK_IMG_PG_UBI_4K '-m 4096 -p 256KiB -s 4096'
fi
if [ "\$CONFIG_LUNA_SDK_IMG_PG_2K" = "y" ] || [ "\$CONFIG_LUNA_SDK_IMG_PG_4K" = "y" ]; then
	define_bool CONFIG_CONFIG_LUNA_SDK_IMG_PG y
fi
endmenu

mainmenu_option next_comment
comment "Software Version Setting"
string 'Software Version' CONFIG_SW_VERSION ''
bool 'Year  (%y)' CONFIG_SWVER_YEAR
bool 'Month (%m)' CONFIG_SWVER_MON
bool 'Day   (%d)' CONFIG_SWVER_DAY
bool 'Hour  (%H)' CONFIG_SWVER_HOUR
bool 'Min   (%M)' CONFIG_SWVER_MIN
endmenu

if [ "\$CONFIG_LUNA_MEMORY_AUTO_DETECTION" != "y" ] && [ "\$CONFIG_VOIP_IPC_DSP_ARCHITECTURE" = "y" ]; then
	comment "RTL8686 IPC Shared Memory Setting"
	if [ "\$CONFIG_LUNA_DUAL_LINUX" = "y" ]; then
        hex  "RTL8686 CPU MEM Base" CONFIG_RTL8686_CPU_MEM_BASE 0x00000000
        hex  "RTL8686 CPU MEM Size" CONFIG_RTL8686_CPU_MEM_SIZE 0x02800000
        hex  "RTL8686 IPC MEM Base" CONFIG_RTL8686_IPC_MEM_BASE 0x02800000
        hex  "RTL8686 IPC MEM Size" CONFIG_RTL8686_IPC_MEM_SIZE 0x00100000
        hex  "RTL8686 DSP MEM Base" CONFIG_RTL8686_DSP_MEM_BASE 0x02900000
        hex  "RTL8686 DSP MEM Size" CONFIG_RTL8686_DSP_MEM_SIZE 0x01700000
	else
	hex  "RTL8686 CPU MEM Base" CONFIG_RTL8686_CPU_MEM_BASE 0x00000000
	hex  "RTL8686 CPU MEM Size" CONFIG_RTL8686_CPU_MEM_SIZE 0x03800000
	hex  "RTL8686 IPC MEM Base" CONFIG_RTL8686_IPC_MEM_BASE 0x03800000
	hex  "RTL8686 IPC MEM Size" CONFIG_RTL8686_IPC_MEM_SIZE 0x00100000
	hex  "RTL8686 DSP MEM Base" CONFIG_RTL8686_DSP_MEM_BASE 0x03900000
	hex  "RTL8686 DSP MEM Size" CONFIG_RTL8686_DSP_MEM_SIZE 0x00700000
	fi
fi

endmenu
!EOF

############################################################################
