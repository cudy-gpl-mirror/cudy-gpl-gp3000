/dts-v1/;
/ {
    description = "fitImage for RTK aarch64 kernel";
    #address-cells = <0x1>;
    images {
        kernel@0 {
            description = "Linux Kernel";
            data = /incbin/("./Image.lzma");
            type = "kernel";
            arch = "arm64";
            os = "linux";
            compression = "lzma";
            load = <0x80000>;
            entry = <0x80000>;
            hash@1 {
                algo = "sha256";
            };
            signature@1 {
                algo = "sha256,rsa2048";
                key-name-hint = "dev";
            };
        };
        fdt@0 {
              description = "Flattened Device Tree blob";
              data = /incbin/("./board_raw.dtb");
              type = "flat_dt";
              load = <0x01800000>;
              arch = "arm64";
              compression = "none";
              hash@1 {
                algo = "sha256";
              };
                signature@1{
                    algo = "sha256,rsa2048";
                    key-name-hint = "dev";
                };
        };
        script@0 {
            description = "Script";
            data = /incbin/("./uboot_verity_script");
            type = "script";
            compression = "none";
            hash@0 {
                algo = "sha256";
            };
            signature@0 {
                algo = "sha256,rsa2048";
                key-name-hint = "dev";
            };
        };
    };
    configurations {
        default = "conf@1";
        conf@1 {
            description = "Boot Linux kernel with FDT blob ";
            kernel = "kernel@0";
            fdt = "fdt@0";
            script = "script@0";
            hash@1 {
                algo = "sha256";
            };
            signature@1 {
                algo = "sha256,rsa2048";
                key-name-hint = "dev";
                sign-images = "fdt", "kernel", "script";
            };
        };
    };
};
